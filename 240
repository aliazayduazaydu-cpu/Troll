-- 8. دوال مساعدة للحصول على أجزاء اللاعب والهدف وإدارة القائمة
------------------------------------------------------------------------------------
local function GetMyRig()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil, nil end
    return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("Head")
end

local function ResolveTarget()
    if SelectedTarget and SelectedTarget.Parent == Players and SelectedTarget.Character then
        if SelectedTarget.Character:FindFirstChild("HumanoidRootPart") then
            return SelectedTarget
        end
    end

    local _, myRoot = GetMyRig()
    local nearest = nil
    local minDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local d = myRoot and (tRoot.Position - myRoot.Position).Magnitude or 0
                if d < minDist then
                    minDist = d
                    nearest = plr
                end
            end
        end
    end

    if nearest then
        TopTitleLabel.Text = " CLASSIC 240 ULTRA SUITE | تلقائي: " .. nearest.Name
    else
        TopTitleLabel.Text = " CLASSIC 240 ULTRA SUITE | لا يوجد لاعب قريب!"
    end

    return nearest
end

local function GetTargetRig()
    local plr = ResolveTarget()
    if not plr or not plr.Character then return nil, nil, nil, nil, nil end
    local tChar = plr.Character
    return plr, tChar, tChar:FindFirstChild("HumanoidRootPart"), tChar:FindFirstChildOfClass("Humanoid"), tChar:FindFirstChild("Head")
end

local function RefreshPlayersUI()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local filter = string.lower(TargetSearchInput.Text)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local m1 = string.find(string.lower(plr.Name), filter, 1, true)
            local m2 = string.find(string.lower(plr.DisplayName), filter, 1, true)
            if filter == "" or m1 or m2 then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 22)
                btn.BackgroundColor3 = (SelectedTarget == plr) and Color3.fromRGB(178, 38, 38) or Color3.fromRGB(40, 40, 48)
                btn.BorderColor3 = Color3.fromRGB(86, 86, 98)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.SourceSans
                btn.TextSize = 12
                btn.Text = plr.DisplayName
                btn.TextTruncate = Enum.TextTruncate.AtEnd
                btn.ZIndex = 13
                btn.Parent = PlayerListScroll

                btn.MouseButton1Click:Connect(function()
                    if SelectedTarget == plr then
                        SelectedTarget = nil
                        TopTitleLabel.Text = " CLASSIC 240 ULTRA SUITE | الهدف: أقرب لاعب"
                    else
                        SelectedTarget = plr
                        TopTitleLabel.Text = " CLASSIC 240 ULTRA SUITE | الهدف: " .. plr.Name
                    end
                    RefreshPlayersUI()
                end)
            end
        end
    end
end

TargetSearchInput:GetPropertyChangedSignal("Text"):Connect(RefreshPlayersUI)
Players.PlayerAdded:Connect(RefreshPlayersUI)
Players.PlayerRemoving:Connect(function(plr)
    if SelectedTarget == plr then SelectedTarget = nil end
    RefreshPlayersUI()
end)
