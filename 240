RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if FeatureStates["Wall Ghost"] or FeatureStates["Phase Hit"] or FeatureStates["Halo Orbit"] or FeatureStates["Ring Orbit"] or FeatureStates["Saw Orbit"] or FeatureStates["Float Stalk"] or FeatureStates["High Orbit"] or FeatureStates["Low Orbit"] or FeatureStates["Head Ride"] or FeatureStates["Chaos Orbit"] then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if FeatureStates["Watch Cam"] then
        local _, tChar = GetTargetRig()
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = tHum
        end
    end
end)

local theta1 = 0
local theta2 = 0

RunService.Heartbeat:Connect(function(dt)
    local char, root, hum = GetMyRig()
    if not char or not root then return end
    local _, _, tRoot, _, tHead = GetTargetRig()

    -- سرعة وقفز عشوائي
    if FeatureStates["Chaos Speed"] and hum then hum.WalkSpeed = math.random(8, 125) end
    if FeatureStates["Chaos Jump"] and hum then hum.JumpPower = math.random(25, 140) end

    -- دوران الرأس والجسم
    if FeatureStates["Head Spin"] or FeatureStates["Neck Wobble"] then
        local neck = char:FindFirstChild("Neck", true)
        if neck and neck:IsA("Motor6D") then
            if FeatureStates["Head Spin"] then
                neck.C0 = neck.C0 * CFrame.Angles(0, math.rad(28), 0)
            else
                neck.C0 = neck.C0 * CFrame.Angles(math.sin(tick() * 24) * 0.14, math.cos(tick() * 24) * 0.14, 0)
            end
        end
    end

    if FeatureStates["Flip Loop"] then root.CFrame = root.CFrame * CFrame.Angles(math.rad(14), 0, 0) end
    if FeatureStates["Twitch Loop"] then root.CFrame = root.CFrame * CFrame.Angles(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1) end

    -- اهتزازات التخريب
    if FeatureStates["Tremor Jerk"] or FeatureStates["Quake Jerk"] or FeatureStates["Pulse Jerk"] or FeatureStates["Snap Jerk"] or FeatureStates["Jolt Loop"] then
        local baseCF = tRoot and tRoot.CFrame or root.CFrame
        local spread = FeatureStates["Quake Jerk"] and 4.5 or (FeatureStates["Snap Jerk"] and 1.0 or 2.4)
        root.CFrame = baseCF * CFrame.new(math.random(-spread, spread), math.random(0, spread * 0.5), math.random(-spread, spread))
    end

    -- مدارات التخريب والترول
    if tRoot and (FeatureStates["Halo Orbit"] or FeatureStates["Ring Orbit"] or FeatureStates["Wave Orbit"] or FeatureStates["Saw Orbit"] or FeatureStates["Drill Orbit"] or FeatureStates["Slam Orbit"] or FeatureStates["Orbit Smash"] or FeatureStates["High Orbit"] or FeatureStates["Low Orbit"] or FeatureStates["Wide Orbit"] or FeatureStates["Tight Orbit"] or FeatureStates["Orbit Fling"] or FeatureStates["LoopOrbitBang"] or FeatureStates["ZigZag Orbit"] or FeatureStates["Figure8 Orbit"] or FeatureStates["Spiral Orbit"] or FeatureStates["Bounce Orbit"] or FeatureStates["Chaos Orbit"]) then
        local spd = (FeatureStates["Drill Orbit"] or FeatureStates["Saw Orbit"] or FeatureStates["Chaos Orbit"]) and 17 or 10
        theta1 = theta1 + dt * spd
        theta2 = theta2 + dt * (spd * 1.35)
        local radius = FeatureStates["Wide Orbit"] and 7.5 or (FeatureStates["Tight Orbit"] and 2.5 or 4.5)
        local pos

        if FeatureStates["Halo Orbit"] or FeatureStates["High Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(theta1) * radius, 4.5, math.sin(theta1) * radius)
        elseif FeatureStates["Low Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(theta1) * radius, -2.5, math.sin(theta1) * radius)
        elseif FeatureStates["Wave Orbit"] or FeatureStates["ZigZag Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(theta1) * radius, math.sin(theta2) * 3.5, 0)
        elseif FeatureStates["Figure8 Orbit"] then
            pos = tRoot.Position + Vector3.new(math.sin(theta1) * radius, 1, math.sin(theta1 * 2) * radius)
        elseif FeatureStates["Bounce Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(theta1) * radius, math.abs(math.sin(theta2)) * 4, math.sin(theta1) * radius)
        elseif FeatureStates["Drill Orbit"] or FeatureStates["Spiral Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(theta2) * radius, ((tick() * 9) % 9) - 2, math.sin(theta2) * radius)
        else
            pos = tRoot.Position + Vector3.new(math.cos(theta1) * radius, 0, math.sin(theta1) * radius)
        end

        root.CFrame = CFrame.new(pos, tRoot.Position)
        if FeatureStates["Orbit Fling"] and math.random() < 0.05 then RunSpinFling(tRoot, 0.3, 120000) end
        if FeatureStates["LoopOrbitBang"] and math.random() < 0.08 then ApplyImpulse(Vector3.new(0, 145, 0), 0.1) end
    end

    -- حلقات Bang المستمرة على الهدف
    if tRoot then
        if FeatureStates["LoopSitBang"] and tHead then
            if hum then hum.Sit = true end
            root.CFrame = tHead.CFrame * CFrame.new(0, 1.3 + math.abs(math.sin(tick() * 18)) * 1.2, 0)
        elseif FeatureStates["LoopFaceBang"] and tHead then
            root.CFrame = tHead.CFrame * CFrame.new(0, 0, -1.1 - math.abs(math.sin(tick() * 18)) * 0.8) * CFrame.Angles(0, math.pi, 0)
        elseif FeatureStates["LoopRearBang"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.0, 1.6 + math.abs(math.sin(tick() * 18)) * 1.2)
        elseif FeatureStates["LoopFrontBang"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.0, -1.6 - math.abs(math.sin(tick() * 18)) * 1.2) * CFrame.Angles(0, math.pi, 0)
        elseif FeatureStates["LoopUnderBang"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -3.2 + math.abs(math.sin(tick() * 18)) * 1.5, 0)
        elseif FeatureStates["LoopSpinBang"] then
            theta2 = theta2 + dt * 15
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.0, 1.8) * CFrame.Angles(0, theta2, 0)
        elseif FeatureStates["LoopRapidBang"] and math.random() < 0.14 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.2, -1.6)
            ApplyImpulse(Vector3.new(0, 175, 0), 0.09)
        end
    end

    -- ملاحقة وحركات الترول على الهدف
    if tRoot then
        if FeatureStates["Back Stalk"] or FeatureStates["Back Ride"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.8) end
        if FeatureStates["Front Stalk"] or FeatureStates["Front Ride"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -2.8) * CFrame.Angles(0, math.pi, 0) end
        if FeatureStates["Left Stalk"] or FeatureStates["Left Ride"] then root.CFrame = tRoot.CFrame * CFrame.new(-3.0, 0, 0) end
        if FeatureStates["Right Stalk"] or FeatureStates["Right Ride"] then root.CFrame = tRoot.CFrame * CFrame.new(3.0, 0, 0) end
        if FeatureStates["Roof Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 5, 0) end
        if FeatureStates["Floor Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, -4, 0) end
        if FeatureStates["Head Ride"] and tHead then if hum then hum.Sit = true end root.CFrame = tHead.CFrame * CFrame.new(0, 1.5, 0) end
        if FeatureStates["Float Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 3 + math.sin(tick() * 6), 2.5) end
        if FeatureStates["Peep Show"] or FeatureStates["Peek Loop"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, (math.floor(tick() * 2) % 2 == 0) and -2.5 or 6) end
        if FeatureStates["Mirror Pose"] or FeatureStates["Shadow Clone"] then root.CFrame = CFrame.new(-tRoot.Position.X, tRoot.Position.Y, -tRoot.Position.Z) end
        if FeatureStates["Hop Stalk"] or FeatureStates["Bob Stalk"] or FeatureStates["Jump Taunt"] then root.CFrame = tRoot.CFrame * CFrame.new(0, math.abs(math.sin(tick() * 8)) * 4, 2.5) end
        if FeatureStates["Sway Stalk"] or FeatureStates["Drift Stalk"] or FeatureStates["Slide Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 10) * 4, 0, 2.5) end
        if FeatureStates["Stare Lock"] or FeatureStates["Creep Stalk"] then root.CFrame = CFrame.new(tRoot.Position + tRoot.CFrame.LookVector * 2.5, tRoot.Position) end
        if FeatureStates["Wiggle Stalk"] or FeatureStates["Pulse Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 14) * 2.2, 0, 2.6) end
        if FeatureStates["Spin Dance"] or FeatureStates["Spin Stalk"] or FeatureStates["Spin Taunt"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.sin(tick() * 12) * 0.9, 0) end
        if FeatureStates["Roll Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, 0, math.sin(tick() * 10) * 0.5) end
        if FeatureStates["Dash Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, math.sin(tick() * 9) * 5) end
        if FeatureStates["Loop Stalk"] then theta1 = theta1 + dt * 5 root.CFrame = tRoot.CFrame * CFrame.new(math.cos(theta1) * 3, 0, math.sin(theta1) * 3) end
        if FeatureStates["Angle Swap"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.rad((math.floor(tick() * 3) % 4) * 90), 0) end
        if FeatureStates["Circle Peek"] then theta1 = theta1 + dt * 6 root.CFrame = tRoot.CFrame * CFrame.new(math.cos(theta1) * 5, 0, math.sin(theta1) * 5) end
        if FeatureStates["Sit Taunt"] and hum then hum.Sit = true root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.4) end
        if FeatureStates["Blink Warp"] or FeatureStates["Warp Loop"] or FeatureStates["Blink Taunt"] then
            if math.random() < 0.08 then
                root.CFrame = tRoot.CFrame * CFrame.new(math.random(-6, 6), math.random(0, 4), math.random(-6, 6))
            end
        end

        -- هجمات تخريب تلقائية مستمرة
        if (FeatureStates["Auto Fling"] or FeatureStates["Mega Loop"]) and math.random() < 0.04 then RunSpinFling(tRoot, 0.35, 99999) end
        if (FeatureStates["Auto Slam"] or FeatureStates["Slam Loop"]) and math.random() < 0.06 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 12, 0)
            ApplyImpulse(Vector3.new(0, -175, 0), 0.16)
        end
        if (FeatureStates["Auto Shock"] or FeatureStates["Shock Loop"] or FeatureStates["Boom Loop"]) and math.random() < 0.06 then
            root.CFrame = tRoot.CFrame
            ApplyImpulse(Vector3.new(math.random(-145, 145), 135, math.random(-145, 145)), 0.14)
        end
        if (FeatureStates["Blitz Loop"] or FeatureStates["Dash Loop"] or FeatureStates["Surge Loop"]) and math.random() < 0.08 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
            ApplyImpulse(tRoot.CFrame.LookVector * 185, 0.12)
        end
        if FeatureStates["Pulse Loop"] and math.random() < 0.08 then ApplyImpulse(Vector3.new(0, 115, 0), 0.12) end
        if FeatureStates["Burst Cycle"] and math.random() < 0.05 then root.CFrame = tRoot.CFrame * CFrame.new(0, -1.5, 0) ApplyImpulse(Vector3.new(0, 185, 0), 0.15) end
        if FeatureStates["Spin Loop"] and math.random() < 0.04 then RunSpinFling(tRoot, 0.3, 110000) end
        if (FeatureStates["Drop Loop"] or FeatureStates["Crash Loop"]) and math.random() < 0.06 then root.CFrame = tRoot.CFrame * CFrame.new(0, 20, 0) ApplyImpulse(Vector3.new(0, -220, 0), 0.15) end
        if FeatureStates["Kick Loop"] and math.random() < 0.06 then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -2) ApplyImpulse(tRoot.CFrame.LookVector * 200 + Vector3.new(0, 90, 0), 0.14) end
    end

    -- وميض بصري
    if FeatureStates["Flash Blink"] or FeatureStates["Fade Blink"] or FeatureStates["Ghost Trail"] then
        local transVal = FeatureStates["Flash Blink"] and (math.random() > 0.5 and 0 or 0.85) or (0.35 + 0.35 * math.sin(tick() * 10))
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = transVal
            end
        end
    end

    -- قفز وجلوس متكرر
    if hum then
        if FeatureStates["Hop Spam"] and math.random() < 0.12 then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if FeatureStates["Sit Spam"] and math.random() < 0.08 then hum.Sit = not hum.Sit end
    end

    -- تأثيرات الكاميرا
    local cam = workspace.CurrentCamera
    if cam then
        if FeatureStates["Shake Cam"] then cam.CFrame = cam.CFrame * CFrame.new(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, 0) end
        if FeatureStates["Tilt Cam"] then cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.rad(math.sin(tick() * 4) * 18)) end
        if FeatureStates["Flip Cam"] then cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.pi) end
        if FeatureStates["Orbit Cam"] and tRoot then
            theta1 = theta1 + dt * 3
            cam.CFrame = CFrame.new(tRoot.Position + Vector3.new(math.cos(theta1)*10, 5, math.sin(theta1)*10), tRoot.Position)
        end
    end
end)

-- حلقة رسائل الشات المرتبطة بالهدف
local counterIdx = 0
task.spawn(function()
    local teases = {"Too slow!", "Catch me!", "No escape!", "Over here!"}
    local alerts = {"Alert: Tracked!", "Warning: Locked!", "Ping active!"}
    local codes = {"#ERR_01#", "0xCHAOS", "!!SYNC!!"}
    local marks = {">:-)", "?!?", "<<<>>>", "***"}

    while true do
        local waitSec = FeatureStates["Fast Pace"] and 0.8 or (FeatureStates["Slow Pace"] and 3.5 or 1.8)
        task.wait(waitSec)

        local plr = ResolveTarget()
        local tName = plr and plr.DisplayName or "Target"
        local msg = nil

        if FeatureStates["Tag Chat"] then
            msg = "[" .. tName .. "] Target active"
        elseif FeatureStates["Tease Chat"] then
            msg = tName .. " - " .. teases[math.random(1, #teases)]
        elseif FeatureStates["Alert Chat"] then
            msg = alerts[math.random(1, #alerts)] .. " " .. tName
        elseif FeatureStates["Code Chat"] then
            msg = codes[math.random(1, #codes)] .. " " .. tName
        elseif FeatureStates["Num Chat"] then
            counterIdx = counterIdx + 1
            msg = tName .. " #" .. tostring(counterIdx)
        elseif FeatureStates["Mark Chat"] then
            msg = tName .. " " .. marks[math.random(1, #marks)]
        end

        if msg then
            SendChatLine(msg)
        end
    end
end)
