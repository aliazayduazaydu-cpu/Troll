local SectionIndex = { Destruction = 0, Troll = 0 }

local function RegisterFeatureButton(section, featureName, isToggle, callback)
    local gridFrame = (section == "Destruction") and DestructionContainer or TrollContainer
    SectionIndex[section] = SectionIndex[section] + 1
    FeatureStates[featureName] = false

    local uniqueIconAsset = GetNextUniqueIcon()

    local btn = Instance.new("TextButton")
    btn.Name = featureName
    btn.LayoutOrder = SectionIndex[section]
    btn.Size = UDim2.new(0, 96, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(42, 42, 50)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(94, 94, 106)
    btn.TextColor3 = Color3.fromRGB(246, 246, 252)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 10
    btn.Text = "     " .. featureName
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.TextTruncate = Enum.TextTruncate.AtEnd
    btn.ZIndex = 13
    btn.Parent = gridFrame

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 14, 0, 14)
    icon.Position = UDim2.new(0, 3, 0.5, -7)
    icon.BackgroundTransparency = 1
    icon.Image = uniqueIconAsset
    icon.ZIndex = 14
    icon.Parent = btn

    table.insert(RegisteredButtons, btn)

    btn.MouseButton1Click:Connect(function()
        if isToggle then
            FeatureStates[featureName] = not FeatureStates[featureName]
            btn.BackgroundColor3 = FeatureStates[featureName] and Color3.fromRGB(186, 40, 40) or Color3.fromRGB(42, 42, 50)
            pcall(callback, FeatureStates[featureName])
        else
            btn.BackgroundColor3 = Color3.fromRGB(212, 124, 28)
            task.delay(0.18, function()
                if btn and btn.Parent then
