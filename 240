-- 10. دوال التنفيذ الفيزيائي وأنماط Bang والشات وإعادة الضبط
------------------------------------------------------------------------------------
local function ApplyImpulse(velVec, duration, restoreCF)
    local _, myRoot = GetMyRig()
    if not myRoot then return end
    local saved = restoreCF or myRoot.CFrame
    myRoot.AssemblyLinearVelocity = velVec
    task.delay(duration or 0.2, function()
        if myRoot and myRoot.Parent then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            if restoreCF then myRoot.CFrame = saved end
        end
    end)
end

local function RunSpinFling(tRoot, duration, angularRate)
    local _, myRoot = GetMyRig()
    if not (myRoot and tRoot) then return end
    local saved = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, angularRate or 99999, 0)
    bav.Parent = myRoot

    local t0 = tick()
    while tick() - t0 < (duration or 0.75) and tRoot.Parent do
        myRoot.CFrame = tRoot.CFrame
        RunService.Heartbeat:Wait()
    end

    bav:Destroy()
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.CFrame = saved
end

local function RunBangStyle(style, count, powerY, useSit)
    local _, _, tRoot, _, tHead = GetTargetRig()
    local _, myRoot, myHum = GetMyRig()
    if not (tRoot and myRoot) then return end

    local savedCF = myRoot.CFrame
    local hits = count or 9
    local velY = powerY or 185

    if useSit and myHum then myHum.Sit = true end

    for idx = 1, hits do
        if not tRoot.Parent or not myRoot.Parent then break end
        local targetCF = tRoot.CFrame

        if style == "SitHead" and tHead then
            targetCF = tHead.CFrame * CFrame.new(0, 1.35, 0)
            if myHum then myHum.Sit = true end
        elseif style == "FaceBang" and tHead then
            targetCF = tHead.CFrame * CFrame.new(0, 0, -1.15) * CFrame.Angles(0, math.pi, 0)
        elseif style == "HeadCrown" and tHead then
            targetCF = tHead.CFrame * CFrame.new(0, 2.1, 0)
        elseif style == "FrontBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, -1.2, -1.8) * CFrame.Angles(0, math.pi, 0)
        elseif style == "RearBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, -1.2, 1.8)
        elseif style == "LeftBang" then
            targetCF = tRoot.CFrame * CFrame.new(-2.0, -1.0, 0)
        elseif style == "RightBang" then
            targetCF = tRoot.CFrame * CFrame.new(2.0, -1.0, 0)
        elseif style == "DiagonalBang" then
            targetCF = tRoot.CFrame * CFrame.new(1.6, -1.0, -1.6)
        elseif style == "SpinBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, -1.2, 1.8) * CFrame.Angles(0, math.rad(idx * 45), 0)
        elseif style == "SkyBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, -1.5, 0)
            velY = 280
        elseif style == "SlamBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, 9, 0)
            velY = -220
        elseif style == "UnderBang" then
            targetCF = tRoot.CFrame * CFrame.new(0, -3.5, 0)
            velY = 240
        end

        myRoot.CFrame = targetCF
        myRoot.AssemblyLinearVelocity = Vector3.new(0, velY, 0)
        task.wait(0.055)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.035)
    end

    if myHum then myHum.Sit = false end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.CFrame = savedCF
end

local function SendChatLine(msg)
    if not msg or msg == "" then return end
    if FeatureStates["Shout Caps"] then msg = string.upper(msg) end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(msg) end
    else
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if ev and ev:FindFirstChild("SayMessageRequest") then
            ev.SayMessageRequest:FireServer(msg, "All")
        end
    end
end

local function StopAndResetEverything()
    for k in pairs(FeatureStates) do FeatureStates[k] = false end
    for _, b in ipairs(RegisteredButtons) do
        if b and b.Parent then b.BackgroundColor3 = Color3.fromRGB(42, 42, 50) end
    end
    local char, root, hum = GetMyRig()
    local cam = workspace.CurrentCamera
    if hum and cam then
        cam.CameraSubject = hum
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.Sit = false
    end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.LocalTransparencyModifier = 0
                p.CanCollide = true
            end
        end
    end
end

