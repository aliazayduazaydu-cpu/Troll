local FullUniqueIcons = {}
local function BuildUniqueIconSet(totalNeeded)
    local used = {}
    for _, idStr in ipairs(BaseIcons) do
        if not used[idStr] then
            used[idStr] = true
            table.insert(FullUniqueIcons, idStr)
        end
    end
    local seedId = 6035100000
    while #FullUniqueIcons < totalNeeded do
        seedId = seedId + 1
        local candidate = "rbxassetid://" .. tostring(seedId)
        if not used[candidate] then
            used[candidate] = true
            table.insert(FullUniqueIcons, candidate)
        end
    end
end

