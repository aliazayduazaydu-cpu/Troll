-- 10. دوال التنفيذ الفيزيائي وأنماط Bang والشات وإعادة الضبط
------------------------------------------------------------------------------------
local function LaunchVelocity(vel, hold, restore)
    local _, myRoot = GetSelfParts()
    if not myRoot then return end
    local oldCF = restore or myRoot.CFrame
    myRoot.AssemblyLinearVelocity = vel
    task.delay(hold or 0.2, function()
        if myRoot and myRoot.Parent then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            if restore then myRoot.CFrame = oldCF end
        end
    end)
end

local function SpinFlingTarget(tRoot, dur, angVel)
    local _, myRoot = GetSelfParts()
    if not (myRoot and tRoot) then return end
    local oldCF = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, angVel or 99999, 0)
    bav.Parent = myRoot

    local startT = tick()
    while tick() - startT < (dur or 0.75) and tRoot.Parent do
        myRoot.CFrame = tRoot.CFrame
        RunService.Heartbeat:Wait()
    end

    bav:Destroy()
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.CFrame = oldCF
end

local function DoBang(mode, steps, powerY, sit)
    local _, _, tRoot, _, tHead = GetTargetParts()
    local _, myRoot, myHum = GetSelfParts()
    if not (tRoot and myRoot) then return end

    local oldCF = myRoot.CFrame
    local n = steps or 9
    local vY = powerY or 185

    if sit and myHum then myHum.Sit = true end

    for i = 1, n do
        if not tRoot.Parent or not myRoot.Parent then break end
        local cf = tRoot.CFrame

        if mode == "SitHead" and tHead then
            cf = tHead.CFrame * CFrame.new(0, 1.35, 0)
            if myHum then myHum.Sit = true end
        elseif mode == "Face" and tHead then
            cf = tHead.CFrame * CFrame.new(0, 0, -1.15) * CFrame.Angles(0, math.pi, 0)
        elseif mode == "Crown" and tHead then
            cf = tHead.CFrame * CFrame.new(0, 2.1, 0)
        elseif mode == "Front" then
            cf = tRoot.CFrame * CFrame.new(0, -1.2, -1.8) * CFrame.Angles(0, math.pi, 0)
        elseif mode == "Rear" then
            cf = tRoot.CFrame * CFrame.new(0, -1.2, 1.8)
        elseif mode == "Left" then
            cf = tRoot.CFrame * CFrame.new(-2.0, -1.0, 0)
        elseif mode == "Right" then
            cf = tRoot.CFrame * CFrame.new(2.0, -1.0, 0)
        elseif mode == "Diag" then
            cf = tRoot.CFrame * CFrame.new(1.6, -1.0, -1.6)
        elseif mode == "Spin" then
            cf = tRoot.CFrame * CFrame.new(0, -1.2, 1.8) * CFrame.Angles(0, math.rad(i * 45), 0)
        elseif mode == "Sky" then
            cf = tRoot.CFrame * CFrame.new(0, -1.5, 0)
            vY = 285
        elseif mode == "Slam" then
            cf = tRoot.CFrame * CFrame.new(0, 9, 0)
            vY = -225
        elseif mode == "Under" then
            cf = tRoot.CFrame * CFrame.new(0, -3.5, 0)
            vY = 245
        end

        myRoot.CFrame = cf
        myRoot.AssemblyLinearVelocity = Vector3.new(0, vY, 0)
        task.wait(0.05)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.03)
    end

    if myHum then myHum.Sit = false end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.CFrame = oldCF
end

local function PushChat(text)
    if not text or text == "" then return end
    if FeatureStates["Shout Caps"] then text = string.upper(text) end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(text) end
    else
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if ev and ev:FindFirstChild("SayMessageRequest") then
            ev.SayMessageRequest:FireServer(text, "All")
        end
    end
end

local function ResetEverything()
    for k in pairs(FeatureStates) do FeatureStates[k] = false end
    for _, b in ipairs(RegisteredButtons) do
        if b and b.Parent then b.BackgroundColor3 = Color3.fromRGB(42, 42, 50) end
    end
    local char, root, hum = GetSelfParts()
    local cam = workspace.CurrentCamera
    if hum and cam then
        cam.CameraSubject = hum
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.Sit = false
    end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.LocalTransparencyModifier = 0
                p.CanCollide = true
            end
        end
    end
end

