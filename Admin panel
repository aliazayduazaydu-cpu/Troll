local function TeleportToPlayer(targetPlr)
	if not targetPlr or targetPlr == LocalPlayer then return end
	local myRoot = GetRoot(LocalPlayer.Character)
	local tRoot = GetRoot(targetPlr.Character)
	if myRoot and tRoot then
		ZeroPhysics(LocalPlayer.Character)
		myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3.2)
	end
end

