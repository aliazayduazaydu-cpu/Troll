local phase = 0

RunService.Heartbeat:Connect(function(dt)
	phase += dt * 15
	local myChar = LocalPlayer.Character
	local myRoot = GetRoot(myChar)
	local myHum = GetHum(myChar)

	for plr, bb in pairs(EspBillboards) do
		local tRoot = GetRoot(plr.Character)
		local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
		if tRoot and myRoot and lbl then
			local dist = math.floor((tRoot.Position - myRoot.Position).Magnitude)
			lbl.Text = plr.DisplayName .. " [" .. tostring(dist) .. "m]"
		end
	end

	if not (myChar and myRoot and myHum) then return end

	for plr, st in pairs(PlayerStates) do
		if plr.Parent == Players and plr.Character then
			local tRoot = GetRoot(plr.Character)
			local tHead = plr.Character:FindFirstChild("Head") or tRoot
			local tHum = GetHum(plr.Character)

			if st.MicHear and tHead then
				Camera.CameraSubject = tHead
			elseif st.View and tHum then
				Camera.CameraSubject = tHum
			end

			if st.FlingLoop and tRoot then
				myHum.PlatformStand = true
				myRoot.CFrame = tRoot.CFrame * CFrame.Angles(math.rad(tick() * 720), 0, 0)
				myRoot.AssemblyLinearVelocity = Vector3.new(9e6, 9e6, 9e6)
				myRoot.AssemblyAngularVelocity = Vector3.new(9e6, 9e6, 9e6)
			end

			if st.Bang and tRoot then
				myHum.PlatformStand = true
				myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1 + math.abs(math.sin(phase)) * 2.5)
				myRoot.AssemblyLinearVelocity = Vector3.zero
			end

			if st.FaceBang and tHead then
				myHum.PlatformStand = true
				myRoot.CFrame = (tHead.CFrame * CFrame.new(0, 0, -1 - math.abs(math.sin(phase)) * 2.5)) * CFrame.Angles(0, math.pi, 0)
				myRoot.AssemblyLinearVelocity = Vector3.zero
			end

			-- Sit Head: جلوس فوق رأس اللاعب
			if st.SitHead and tHead then
				myHum.Sit = true
				myRoot.CFrame = tHead.CFrame * CFrame.new(0, 1.25, 0.25)
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end

			-- Sit Back: جلوس على ظهر اللاعب
			if st.SitBack and tRoot then
				myHum.Sit = true
				myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0.55, 1.35)
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end

			-- مايك خفي: أسفل اللاعب بمسافة عميقة + عودة عند الإيقاف
			if st.StealthMic and tRoot then
				myHum.PlatformStand = false
				local deepUnderPos = tRoot.Position - Vector3.new(0, 11, 0)
				myRoot.CFrame = CFrame.lookAt(deepUnderPos, tRoot.Position)
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end

			if st.Freeze and tRoot then
				pcall(function()
					tRoot.AssemblyLinearVelocity = Vector3.zero
