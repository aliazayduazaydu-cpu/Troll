-- تنسيق مكعبي عصري (حواف 4px مع إطار مزدوج يعطي إحساس ماين كرافت الحديث)
local function ApplyMcBlock(obj, bg, borderCol, radius)
	obj.BackgroundColor3 = bg or Theme.Stone
	obj.BorderSizePixel = 0

	local corner = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 4)
	corner.Parent = obj

	local stroke = obj:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.Color = borderCol or Theme.BorderLight
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = obj

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		obj.Font = Enum.Font.Arcade
		obj.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		obj.TextStrokeTransparency = 0.15
	end
end

local function GetRoot(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function GetHum(char)
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function ZeroPhysics(char)
	if not char then return end
	local hum = GetHum(char)
	if hum then
		hum.PlatformStand = false
		hum.Sit = false
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
	end
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			v.AssemblyLinearVelocity = Vector3.zero
			v.AssemblyAngularVelocity = Vector3.zero
			v.Velocity = Vector3.zero
			v.RotVelocity = Vector3.zero
		end
	end
end

local function ClampToScreen(frame)
	local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
	local absX = frame.Position.X.Scale * vp.X + frame.Position.X.Offset
	local absY = frame.Position.Y.Scale * vp.Y + frame.Position.Y.Offset
	local x = math.clamp(absX, 6, math.max(6, vp.X - frame.AbsoluteSize.X - 6))
	local y = math.clamp(absY, 6, math.max(6, vp.Y - frame.AbsoluteSize.Y - 6))
	frame.Position = UDim2.fromOffset(x, y)
end

local function MakeDraggable(handle, frame)
	local drag = false
	local startIn, startPos
	handle.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			drag = true
			startIn = inp.Position
			startPos = frame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			local d = inp.Position - startIn
			frame.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
			ClampToScreen(frame)
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			drag = false
			ClampToScreen(frame)
		end
	end)
end

local PlayerStates = {}

local function GetState(plr)
	if not PlayerStates[plr] then
		PlayerStates[plr] = {
			Esp = false,
			MicHear = false,
			View = false,
			Bang = false,
			FaceBang = false,
			FlingLoop = false,
			Freeze = false,
			InfJump = false,
			StealthMic = false,
			SitHead = false,
			SitBack = false,
			SavedCF = nil,
		}
	end
	return PlayerStates[plr]
end

local function SaveMyPos(st)
	local myRoot = GetRoot(LocalPlayer.Character)
	if myRoot and myRoot.AssemblyLinearVelocity.Magnitude < 120 and not st.SavedCF then
		st.SavedCF = myRoot.CFrame
	end
end

local function RestoreMyPos(st)
	local char = LocalPlayer.Character
	local myRoot = GetRoot(char)
	local cf = st and st.SavedCF
	if char and myRoot then
		ZeroPhysics(char)
		if cf then
			for _ = 1, 5 do
				myRoot.CFrame = cf * CFrame.new(0, 0.5, 0)
				ZeroPhysics(char)
				task.wait()
			end
			st.SavedCF = nil
		end
	end
end

