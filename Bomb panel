	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	if not state.invisibleFloating then
		state.savedCFrame = root.CFrame
		state.oldSpotPosition = root.Position

		glassBox.CFrame = CFrame.new(state.oldSpotPosition)
		glassBox.Parent = workspace

		root.CFrame = CFrame.new(farAnchorPos)
		lockFloatingCharacter(true)

		state.invisibleFloating = true
