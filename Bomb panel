-- Bomb Orbit Transfer (Ultra-close fast orbit around target, then return)
local function transferBombTool(targetPlayer)
	if not targetPlayer then return end
	local myChar = player.Character
	local bombTool = (myChar and myChar:FindFirstChildWhichIsA("Tool")) or player.Backpack:FindFirstChildWhichIsA("Tool")
	if bombTool and targetPlayer:FindFirstChild("Backpack") then
		bombTool.Parent = targetPlayer.Backpack
	end
end

local function orbitAndGiveBomb(targetPlayer)
	if state.orbitActive or not targetPlayer or not targetPlayer.Character then return end
	local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not targetRoot or not myRoot then return end

	state.orbitActive = true
	local returnCF = myRoot.CFrame
	local wasAnchored = myRoot.Anchored
	myRoot.Anchored = true

	local duration = 1.3
	local elapsed = 0
	local orbitRadius = 0.8

	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			conn:Disconnect()
			myRoot.Anchored = wasAnchored
			myRoot.CFrame = returnCF
			state.orbitActive = false
			return
		end

		local tRoot = targetPlayer.Character.HumanoidRootPart
		local angle = elapsed * 24
		local offset = Vector3.new(math.cos(angle) * orbitRadius, 0, math.sin(angle) * orbitRadius)
		local orbitPos = tRoot.Position + offset
		myRoot.CFrame = CFrame.lookAt(orbitPos, tRoot.Position)

		if elapsed >= duration then
			conn:Disconnect()
			transferBombTool(targetPlayer)
			myRoot.CFrame = returnCF
			myRoot.Anchored = wasAnchored
			state.orbitActive = false
		end
	end)
end

local function getNearestPlayer()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local bestPlayer, bestDist = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local d = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
			if d < bestDist then
				bestDist = d
				bestPlayer = p
			end
		end
	end
	return bestPlayer
end

