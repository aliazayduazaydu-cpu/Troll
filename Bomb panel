-- Clamp GUI inside viewport so it never escapes screen corners
local function clampToScreen(guiObject)
	local screenSize = camera.ViewportSize
	local absPos = guiObject.AbsolutePosition
	local absSize = guiObject.AbsoluteSize

	local maxX = math.max(0, screenSize.X - absSize.X)
	local maxY = math.max(0, screenSize.Y - absSize.Y)

	guiObject.Position = UDim2.fromOffset(
		math.clamp(absPos.X, 0, maxX),
		math.clamp(absPos.Y, 0, maxY)
	)
end

-- Distinguish between Drag and Click/Tap
local function makeDraggable(dragHandle, targetFrame, onClickCallback)
	local dragging = false
	local moved = false
	local dragStart = Vector2.zero
	local startPos = UDim2.fromOffset(0, 0)
	local threshold = 6

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = targetFrame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local now = Vector2.new(input.Position.X, input.Position.Y)
			local delta = now - dragStart
			if delta.Magnitude > threshold then
				moved = true
			end
			if moved then
				targetFrame.Position = UDim2.fromOffset(startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y)
				clampToScreen(targetFrame)
			end
		end
	end)

	dragHandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				if not moved and onClickCallback then
					onClickCallback()
				end
			end
		end
	end)
end

-- Modern Minecraft Deepslate + Emerald Styling
local function styleModernMcBlock(guiObj, topColor, bottomColor, strokeColor, radiusPx, strokeThickness)
	guiObj.BackgroundColor3 = topColor
	guiObj.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radiusPx or 6)
	corner.Parent = guiObj

	local stroke = Instance.new("UIStroke")
	stroke.Color = strokeColor or Color3.fromRGB(22, 26, 24)
	stroke.Thickness = strokeThickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = guiObj

	if bottomColor then
		local grad = Instance.new("UIGradient")
		grad.Rotation = 90
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, topColor),
			ColorSequenceKeypoint.new(1, bottomColor),
		})
		grad.Parent = guiObj
	end
end

local function createMcButton(parent, text, size, pos, stateActive)
	local btn = Instance.new("TextButton")
	btn.Text = text
	btn.Size = size
	btn.Position = pos or UDim2.fromOffset(0, 0)
	btn.Font = Enum.Font.Arcade
	btn.TextSize = 13
	btn.TextColor3 = Color3.fromRGB(245, 252, 246)
	btn.AutoButtonColor = true

	if stateActive then
		styleModernMcBlock(btn, Color3.fromRGB(46, 158, 78), Color3.fromRGB(28, 108, 52), Color3.fromRGB(130, 245, 160), 6, 1.8)
	else
		styleModernMcBlock(btn, Color3.fromRGB(72, 78, 75), Color3.fromRGB(48, 53, 51), Color3.fromRGB(24, 27, 25), 6, 1.8)
	end

	btn.Parent = parent
	return btn
end

local function setButtonActiveVisual(btn, isActive)
	local grad = btn:FindFirstChildOfClass("UIGradient")
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if isActive then
		btn.BackgroundColor3 = Color3.fromRGB(46, 158, 78)
		if grad then
			grad.Color = ColorSequence.new(Color3.fromRGB(46, 158, 78), Color3.fromRGB(28, 108, 52))
		end
		if stroke then
			stroke.Color = Color3.fromRGB(135, 248, 165)
		end
	else
		btn.BackgroundColor3 = Color3.fromRGB(72, 78, 75)
		if grad then
			grad.Color = ColorSequence.new(Color3.fromRGB(72, 78, 75), Color3.fromRGB(48, 53, 51))
		end
		if stroke then
			stroke.Color = Color3.fromRGB(24, 27, 25)
		end
	end
end

