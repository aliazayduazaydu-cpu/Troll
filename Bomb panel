local function clampToScreen(guiObject)
	local screenSize = camera.ViewportSize
	local absPos = guiObject.AbsolutePosition
	local absSize = guiObject.AbsoluteSize

	local maxX = math.max(0, screenSize.X - absSize.X)
	local maxY = math.max(0, screenSize.Y - absSize.Y)

	guiObject.Position = UDim2.fromOffset(
		math.clamp(absPos.X, 0, maxX),
		math.clamp(absPos.Y, 0, maxY)
	)
end

local function makeDraggable(dragHandle, targetFrame, onClickCallback)
	local dragging = false
	local moved = false
	local dragStart = Vector2.zero
	local startPos = UDim2.fromOffset(0, 0)
	local threshold = 6

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = targetFrame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local now = Vector2.new(input.Position.X, input.Position.Y)
			local delta = now - dragStart
			if delta.Magnitude > threshold then
				moved = true
			end
			if moved then
				targetFrame.Position = UDim2.fromOffset(startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y)
				clampToScreen(targetFrame)
			end
		end
	end)

	dragHandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				if not moved and onClickCallback then
					onClickCallback()
				end
			end
		end
	end)
end

-- High-craft Minecraft theme styling
local function applyMcSurface(obj, c1, c2, strokeColor, radius, thickness)
	obj.BackgroundColor3 = c1
	obj.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 7)
	corner.Parent = obj

	local stroke = Instance.new("UIStroke")
	stroke.Color = strokeColor or Color3.fromRGB(18, 20, 19)
	stroke.Thickness = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = obj

	if c2 then
		local grad = Instance.new("UIGradient")
		grad.Rotation = 90
		grad.Color = ColorSequence.new(c1, c2)
		grad.Parent = obj
	end
end

local function createMcButton(parent, text, size, pos, active)
	local btn = Instance.new("TextButton")
	btn.Text = text
	btn.Size = size
	btn.Position = pos or UDim2.fromOffset(0, 0)
	btn.Font = Enum.Font.Arcade
	btn.TextSize = 13
	btn.TextColor3 = Color3.fromRGB(246, 252, 247)
	btn.AutoButtonColor = true

	if active then
		applyMcSurface(btn, Color3.fromRGB(56, 178, 86), Color3.fromRGB(30, 115, 52), Color3.fromRGB(155, 255, 178), 7, 1.8)
	else
		applyMcSurface(btn, Color3.fromRGB(66, 72, 70), Color3.fromRGB(42, 46, 45), Color3.fromRGB(20, 23, 22), 7, 1.8)
	end

	btn.Parent = parent
	return btn
end

local function setMcButtonState(btn, isOn)
	local grad = btn:FindFirstChildOfClass("UIGradient")
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if isOn then
		btn.BackgroundColor3 = Color3.fromRGB(56, 178, 86)
		if grad then
			grad.Color = ColorSequence.new(Color3.fromRGB(56, 178, 86), Color3.fromRGB(30, 115, 52))
		end
		if stroke then
			stroke.Color = Color3.fromRGB(155, 255, 178)
		end
	else
		btn.BackgroundColor3 = Color3.fromRGB(66, 72, 70)
		if grad then
			grad.Color = ColorSequence.new(Color3.fromRGB(66, 72, 70), Color3.fromRGB(42, 46, 45))
		end
		if stroke then
			stroke.Color = Color3.fromRGB(20, 23, 22)
		end
	end
end

