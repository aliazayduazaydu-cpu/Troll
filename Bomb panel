local fcPos = Vector3.zero
local fcYaw, fcPitch = 0, 0

freecamBtn.MouseButton1Click:Connect(function()
	state.freecam = not state.freecam
	freecamBtn.Text = state.freecam and "8. FREECAM: ON" or "8. FREECAM: OFF"
	setMcButtonState(freecamBtn, state.freecam)
	freecamPad.Visible = state.freecam

	if state.freecam then
		state.viewingBox = false
		viewBoxBtn.Text = "VIEW OLD BOX: OFF"
		setMcButtonState(viewBoxBtn, false)
		fcPos = camera.CFrame.Position
		local _, y, x = camera.CFrame:ToEulerAnglesYXZ()
		fcYaw, fcPitch = y, x
		camera.CameraType = Enum.CameraType.Scriptable
	else
		moveDir = Vector3.zero
		camera.CameraType = Enum.CameraType.Custom
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end
end)

UserInputService.TouchMoved:Connect(function(touch, processed)
	if processed then return end
	if touch.Position.X > camera.ViewportSize.X * 0.4 then
		if state.freecam then
			fcYaw = fcYaw - touch.Delta.X * 0.0055
			fcPitch = math.clamp(fcPitch - touch.Delta.Y * 0.0055, math.rad(-82), math.rad(82))
		elseif state.viewingBox then
			boxYaw = boxYaw - touch.Delta.X * 0.0055
			boxPitch = math.clamp(boxPitch - touch.Delta.Y * 0.0055, math.rad(-82), math.rad(82))
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if state.ragdollFlat and hum and root and not state.invisibleFloating then
		hum.PlatformStand = true
		if hum.MoveDirection.Magnitude > 0 then
			root.CFrame = root.CFrame + (hum.MoveDirection * state.walkSpeed * dt)
		end
	end

	if state.noclip and char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if state.freecam then
		local rot = CFrame.fromEulerAnglesYXZ(fcPitch, fcYaw, 0)
		local dir = (rot:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z))) + Vector3.new(0, moveDir.Y, 0)
		if dir.Magnitude > 0 then
			fcPos = fcPos + dir.Unit * 48 * dt
		end
		camera.CFrame = CFrame.new(fcPos) * rot
	elseif state.viewingBox and state.invisibleFloating and state.oldSpotPosition then
		local rot = CFrame.fromEulerAnglesYXZ(boxPitch, boxYaw, 0)
		local focus = state.oldSpotPosition
		local camOffset = rot:VectorToWorldSpace(Vector3.new(0, 0, 10))
		camera.CFrame = CFrame.lookAt(focus + camOffset, focus)
	end
end)

