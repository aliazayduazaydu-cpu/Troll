-- Effects state

local Active = {}
local Effects = {}

local function SetStatus(message)
    Status.Text = "STATUS: " .. message
end

local function GetCharacter()
    return Player.Character
end

local function StopEffect(name)
    local effect = Active[name]
    if effect then
        effect:Disconnect()
        Active[name] = nil
    end

    local callback = Effects[name] and Effects[name].Stop
    if callback then
        callback()
    end
end

local function Register(name, callback, stop)
    Effects[name] = {
        Run = callback,
        Stop = stop
    }
end

local function ToggleEffect(name)
    if Active[name] then
        StopEffect(name)
        SetStatus(name .. " OFF")
        return
    end

    local effect = Effects[name]
    if not effect then return end

    local success, result = pcall(effect.Run)

    if success then
        if typeof(result) == "RBXScriptConnection" then
            Active[name] = result
        else
            Active[name] = true
        end
        SetStatus(name .. " ON")
    else
        SetStatus("ERROR")
        warn(result)
    end
end

-- 1. Rainbow character

Register("RAINBOW", function()
    local character = GetCharacter()
    if not character then return end

    local parts = {}

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(parts, {
                part = obj,
                color = obj.Color
            })
        end
    end

    local connection = RunService.Heartbeat:Connect(function()
        local hue = (os.clock() * 0.35) % 1
        for _, item in ipairs(parts) do
            if item.part.Parent then
                item.part.Color = Color3.fromHSV(hue, 0.85, 1)
            end
        end
    end)

    return connection
end, function()
    -- Original colors are restored on respawn.
end)

-- 2. Head spin

Register("HEAD SPIN", function()
    local character = GetCharacter()
    local head = character and character:FindFirstChild("Head")
    if not head then return end

    local motor = head:FindFirstChildWhichIsA("Motor6D")
    if not motor then return end

    local original = motor.Transform

    local connection = RunService.RenderStepped:Connect(function()
        motor.Transform = original *
            CFrame.Angles(0, os.clock() * 8, 0)
    end)

    return connection
end, function()
    local character = GetCharacter()
    local head = character and character:FindFirstChild("Head")
    local motor = head and head:FindFirstChildWhichIsA("Motor6D")
    if motor then
        motor.Transform = CFrame.new()
    end
end)

-- 3. Crazy camera shake

Register("SHAKE", function()
    local camera = workspace.CurrentCamera
    local original = camera.CFrame

    local connection = RunService.RenderStepped:Connect(function()
        local x = math.sin(os.clock() * 20) * 0.08
        local y = math.cos(os.clock() * 17) * 0.08
        camera.CFrame = camera.CFrame * CFrame.new(x, y, 0)
    end)

    return connection
end)

