-- 6.4 Jerk (اهتزاز الجسم)
local function Jerk(targetPlayer, duration)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local startTime = tick()
        local jerkConnection
        jerkConnection = RunService.Heartbeat:Connect(function()
            if tick() - startTime > (duration or 3) then
                jerkConnection:Disconnect()
                return
            end
            -- تغيير الموقع بسرعة متقطعة
            root.CFrame = root.CFrame * CFrame.new(math.random(-1, 1), math.random(0, 1), math.random(-1, 1))
        end)
    end
end

-- 6.5 Speed Chaos (تغيير السرعة بشكل عشوائي)
local function SpeedChaos(targetPlayer, duration)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local startTime = tick()
        local speedConnection
        speedConnection = RunService.Heartbeat:Connect(function()
            if tick() - startTime > (duration or 5) then
                speedConnection:Disconnect()
                if humanoid then humanoid.WalkSpeed = 16 end -- إعادة السرعة الطبيعية
                return
            end
            humanoid.WalkSpeed = math.random(0, 200) -- سرعة عشوائية بين 0 و 200
        end)
    end
end

-- 6.6 NoClip (المرور عبر الجدران)
local function NoClip(targetPlayer, enable)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local noclipConnection
    if enable then
        noclipConnection = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
        -- تخزين الاتصال لإيقافه لاحقاً (يمكن استخدام جدول)
        char:SetAttribute("NoclipConnection", noclipConnection)
    else
        local conn = char:GetAttribute("NoclipConnection")
        if conn then
            conn:Disconnect()
            char:SetAttribute("NoclipConnection", nil)
        end
        -- إعادة التصادم
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

-- 6.7 Chat Spam (إجبار اللاعب على إرسال رسائل)
