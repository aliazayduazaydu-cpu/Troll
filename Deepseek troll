-- دالة مساعدة للحصول على الشخصية
local function GetCharacter(player)
    if not player then return nil end
    return player.Character or player.CharacterAdded:Wait()
end

-- دالة إرسال الأمر إلى السيرفر (أو التنفيذ المحلي إذا لم يوجد سيرفر)
local function FireTroll(Action, Target)
    if not Target then
        -- إذا لم يتم تحديد هدف، يمكن تطبيق التأثير على اللاعب المحلي أو إظهار رسالة
        StarterGui:SetCore("SendNotification", {
            Title = "Troll UI";
            Text = "No target selected!";
            Duration = 2;
        })
        return
    end
    -- إرسال الأمر عبر RemoteEvent
    TrollRemote:FireServer(Action, Target)
    -- يمكنك أيضاً تنفيذ التأثير محلياً إذا كنت تريد رؤيته فوراً (اختياري)
end

-- 6.1 Bang (قفزة عنيفة)
local function Bang(targetPlayer)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.Velocity = Vector3.new(0, 150, 0) -- قوة رأسية عنيفة
        -- يمكن إضافة دوران عشوائي
        root.RotVelocity = Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
    end
end

-- 6.2 Fling (رمي اللاعب)
local function Fling(targetPlayer)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        -- إنشاء BodyVelocity لرمي اللاعب بقوة
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(math.random(-500, 500), math.random(200, 500), math.random(-500, 500))
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = root
        task.delay(0.5, function()
            if bv then bv:Destroy() end
        end)
        -- إضافة BodyAngularVelocity لجعله يدور
        local bav = Instance.new("BodyAngularVelocity")
        bav.AngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.Parent = root
        task.delay(1, function()
            if bav then bav:Destroy() end
        end)
    end
end

