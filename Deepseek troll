    -- ملاحظة: إجبار لاعب آخر على إرسال رسائل في الشات يتطلب RemoteEvent وموافقة السيرفر.
    -- هنا نرسل الأمر إلى السيرفر عبر RemoteEvent.
    TrollRemote:FireServer("ChatSpam", targetPlayer, duration or 5)
    -- كخيار محلي: يمكنك إرسال رسائل من حسابك أنت (غير مستحسن)
end

-- 6.8 Head Spin (تدوير الرأس 360 درجة)
local function HeadSpin(targetPlayer, enable)
    local char = GetCharacter(targetPlayer)
    if not char then return end
    local head = char:FindFirstChild("Head")
    local neck = head and head:FindFirstChild("Neck")
    if neck then
        if enable then
            -- إيقاف أي تدوير سابق
            local oldConn = head:GetAttribute("HeadSpinConnection")
            if oldConn then oldConn:Disconnect() end

            local spinConnection
            spinConnection = RunService.RenderStepped:Connect(function()
                if neck and neck.Parent then
                    neck.C0 = neck.C0 * CFrame.Angles(0, math.rad(10), 0) -- تدوير مستمر
                end
            end)
            head:SetAttribute("HeadSpinConnection", spinConnection)
        else
            local conn = head:GetAttribute("HeadSpinConnection")
            if conn then
                conn:Disconnect()
                head:SetAttribute("HeadSpinConnection", nil)
            end
            -- إعادة الرقبة إلى وضعها الطبيعي (تقريبي)
            if neck then
                neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end
    end
end

