local function getUiParent()
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		return hui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function safeMakeFolder(name)
	if typeof(makefolder) == "function" then
		pcall(makefolder, name)
	end
end

local function safeWriteFile(path, content)
	if typeof(writefile) == "function" then
		pcall(writefile, path, content)
	end
end

local function safeClipboard(text)
	if typeof(setclipboard) == "function" then
		pcall(setclipboard, tostring(text))
	end
end

local function runLoadstring(codeText, sourceName)
	if type(codeText) ~= "string" or codeText:match("^%s*$") then
		warn("[Executor] Empty script.")
		return false
	end

	local loaderFn = loadstring
	if type(loaderFn) ~= "function" then
		warn("[Executor] loadstring is not available in this environment.")
		return false
	end

	local compiled, compileErr = loaderFn(codeText, "@" .. (sourceName or "ExecutorScript"))
	if not compiled then
		warn("[Executor] Compile error: " .. tostring(compileErr))
		return false
	end

	local success, runtimeErr = pcall(compiled)
	if not success then
		warn("[Executor] Runtime error: " .. tostring(runtimeErr))
		return false
	end

	return true
end

