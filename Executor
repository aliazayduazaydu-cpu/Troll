-- ضبط الحجم والموضع تلقائياً عند تغيير حجم الشاشة أو دورانها
local function updateResponsiveLayout()
	local camera = workspace.CurrentCamera
	local vp = (camera and camera.ViewportSize) or Vector2.new(1280, 720)

	local winW = math.clamp(vp.X - (SAFE_MARGIN * 2) - 64, 320, 720)
	local winH = math.clamp(vp.Y - (SAFE_MARGIN * 2), 240, 440)
	MainWindow.Size = UDim2.fromOffset(winW, winH)

	if MainWindow.AbsolutePosition.X == 0 and MainWindow.AbsolutePosition.Y == 0 then
		local centerX = (vp.X - winW) * 0.5
		local centerY = (vp.Y - winH) * 0.5
		clampPositionToViewport(MainWindow, centerX, centerY)
	else
		clampPositionToViewport(MainWindow, MainWindow.AbsolutePosition.X, MainWindow.AbsolutePosition.Y)
	end

	clampPositionToViewport(ToggleButton, ToggleButton.AbsolutePosition.X, ToggleButton.AbsolutePosition.Y)
end

