local function performScriptSearch(query)
	clearSearchResults()
	local q = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if q == "" then
		q = "hub"
	end

	local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(q)
	local ok, rawBody = pcall(function()
		return game:HttpGetAsync(url)
	end)
	if not ok or not rawBody then
		warn("[Search] Failed to fetch from ScriptBlox.")
		return
	end

	local decOk, decoded = pcall(function()
		return HttpService:JSONDecode(rawBody)
	end)
	if not decOk or not decoded or not decoded.result or type(decoded.result.scripts) ~= "table" then
		warn("[Search] Invalid JSON response.")
		return
	end

	for _, item in ipairs(decoded.result.scripts) do
		if item.scriptType == "free" and item.isPatched == false then
			local thumbUrl = ROBLOX_ICONS.DefaultThumb
			if not item.isUniversal and item.game and item.game.gameId then
				thumbUrl = "https://assetgame.roblox.com/Game/Tools/ThumbnailAsset.ashx?aid=" .. tostring(item.game.gameId) .. "&fmt=png&wd=420&ht=420"
			end
			addSearchCard(item.title, item.game and item.game.name or "Universal", item.script, thumbUrl)
		end
	end
end

