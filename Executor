-- دالة حصر أي عنصر داخل حدود الشاشة الآمنة لمنع اختفائه في الزوايا أو خارج الشاشة
local SAFE_MARGIN = 12

local function clampPositionToViewport(frameObj, targetX, targetY)
	local camera = workspace.CurrentCamera
	local vpSize = (camera and camera.ViewportSize) or Vector2.new(1280, 720)
	local size = frameObj.AbsoluteSize

	local minX = SAFE_MARGIN
	local minY = SAFE_MARGIN
	local maxX = math.max(minX, vpSize.X - size.X - SAFE_MARGIN)
	local maxY = math.max(minY, vpSize.Y - size.Y - SAFE_MARGIN)

	local clampedX = math.clamp(targetX, minX, maxX)
	local clampedY = math.clamp(targetY, minY, maxY)

	frameObj.Position = UDim2.fromOffset(clampedX, clampedY)
end

-- تفعيل السحب الآمن لأي إطار أو زر دون السماح له بالخروج أو الانحشار في الزوايا
local function enableSafeDrag(dragHandle, targetFrame, onTapCallback)
	local dragging = false
	local movedDistance = 0
	local dragStartInputPos = Vector2.zero
	local dragStartFramePos = Vector2.zero

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			movedDistance = 0
			dragStartInputPos = input.Position
			dragStartFramePos = Vector2.new(targetFrame.AbsolutePosition.X, targetFrame.AbsolutePosition.Y)

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					clampPositionToViewport(targetFrame, targetFrame.AbsolutePosition.X, targetFrame.AbsolutePosition.Y)
					if movedDistance < 8 and type(onTapCallback) == "function" then
						onTapCallback()
					end
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStartInputPos
			movedDistance = math.max(movedDistance, delta.Magnitude)
			local nextX = dragStartFramePos.X + delta.X
			local nextY = dragStartFramePos.Y + delta.Y
			clampPositionToViewport(targetFrame, nextX, nextY)
		end
	end)
end

