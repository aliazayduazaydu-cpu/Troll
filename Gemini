RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if Active["NoClip Mode"] or Active["Hover Target"] or Active["Orbit Chaos"] or Active["Fast Orbit"] then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if Active["Spectate"] then
        local _, tChar = GetTargetParts()
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = tHum
        end
    end
end)

local angleA = 0
local angleB = 0
RunService.Heartbeat:Connect(function(dt)
    local char, root, hum = GetMyParts()
    if not char or not root then return end

    local _, _, tRoot = GetTargetParts()

    -- سرعة وقفز عشوائي
    if Active["Speed Chaos"] and hum then
        hum.WalkSpeed = math.random(8, 125)
    end
    if Active["Jump Chaos"] and hum then
        hum.JumpPower = math.random(25, 140)
    end

    -- دوران الرأس والجسم
    if Active["Head Spin 360"] or Active["Head Wobble"] then
        local neck = char:FindFirstChild("Neck", true)
        if neck and neck:IsA("Motor6D") then
            if Active["Head Spin 360"] then
                neck.C0 = neck.C0 * CFrame.Angles(0, math.rad(28), 0)
            else
                neck.C0 = neck.C0 * CFrame.Angles(math.sin(tick() * 25) * 0.15, math.cos(tick() * 25) * 0.15, 0)
            end
        end
    end

    if Active["Flip Body"] then
        root.CFrame = root.CFrame * CFrame.Angles(math.rad(14), 0, 0)
    end

    if Active["Twitch Pose"] then
        root.CFrame = root.CFrame * CFrame.Angles(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1)
    end

    -- اهتزازات Jerk
    if Active["Jerk Shake"] or Active["Micro Jerk"] or Active["Wild Jerk"] then
        local base = tRoot and tRoot.CFrame or root.CFrame
        local spread = Active["Wild Jerk"] and 4.5 or (Active["Micro Jerk"] and 0.7 or 2.2)
        root.CFrame = base * CFrame.new(math.random(-spread, spread), math.random(0, spread * 0.5), math.random(-spread, spread))
    end

    -- دوران حول الهدف
    if tRoot and (Active["Orbit Chaos"] or Active["Fast Orbit"] or Active["Vertical Orbit"] or Active["Tornado Spin"]) then
        local spd = Active["Fast Orbit"] and 18 or 10
        angleA = angleA + dt * spd
        angleB = angleB + dt * (spd * 1.4)
        local pos
        if Active["Vertical Orbit"] then
            pos = tRoot.Position + Vector3.new(math.cos(angleA) * 4, math.sin(angleB) * 5, 0)
        elseif Active["Tornado Spin"] then
            local h = ((tick() * 8) % 10) - 2
            pos = tRoot.Position + Vector3.new(math.cos(angleB) * 5, h, math.sin(angleB) * 5)
        else
            pos = tRoot.Position + Vector3.new(math.cos(angleA) * 4.5, 0, math.sin(angleA) * 4.5)
        end
        root.CFrame = CFrame.new(pos, tRoot.Position)
    end

    -- أنماط الملاحقة والالتصاق بالهدف
    if tRoot then
        if Active["Follow Back"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
        if Active["Follow Front"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0) end
        if Active["Follow Left"] then root.CFrame = tRoot.CFrame * CFrame.new(-3.2, 0, 0) end
        if Active["Follow Right"] then root.CFrame = tRoot.CFrame * CFrame.new(3.2, 0, 0) end
        if Active["Follow Above"] or Active["Hover Target"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 4.5, 0) end
        if Active["Follow Under"] then root.CFrame = tRoot.CFrame * CFrame.new(0, -3.5, 0) end
        if Active["Shadow Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 5) end
        if Active["Mirror Move"] then root.CFrame = CFrame.new(-tRoot.Position.X, tRoot.Position.Y, -tRoot.Position.Z) end
        if Active["Peekaboo"] then
            local zOff = (math.floor(tick() * 2) % 2 == 0) and -2.5 or 6
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0, zOff)
        end
        if Active["Circle Strafe"] then
            angleA = angleA + dt * 7
            root.CFrame = tRoot.CFrame * CFrame.new(math.cos(angleA) * 6, 0, math.sin(angleA) * 6)
        end
        if Active["Bounce Stalk"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, math.abs(math.sin(tick() * 8)) * 4, 2.5)
        end
        if Active["ZigZag Stalk"] then
            root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 10) * 4, 0, 2.5)
        end
        if Active["Face Stare"] then
            root.CFrame = CFrame.new(tRoot.Position + tRoot.CFrame.LookVector * 2.5, tRoot.Position)
        end
        if Active["Tail Wag"] then
            root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 14) * 2.2, 0, 2.6)
        end
        if Active["Dance Stalk"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.sin(tick() * 12) * 0.8, 0)
        end
        if Active["Random TP"] and math.random() < 0.08 then
            root.CFrame = tRoot.CFrame * CFrame.new(math.random(-6, 6), math.random(0, 4), math.random(-6, 6))
        end
        if Active["Auto Frenzy"] and math.random() < 0.05 then
            PulseVelocity(root, Vector3.new(math.random(-90, 90), 110, math.random(-90, 90)), 0.12)
        end
    end

    -- وميض وإخفاء جزئي
    if Active["Strobe Flash"] or Active["Ghost Blink"] then
        local val = Active["Strobe Flash"] and (math.random() > 0.5 and 0 or 0.85) or (0.35 + 0.35 * math.sin(tick() * 10))
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.LocalTransparencyModifier = val
            end
        end
    end

    -- قفز وجلوس متكرر
    if hum then
        if Active["Spam Jump"] and math.random() < 0.12 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        if Active["Spam Sit"] and math.random() < 0.08 then
            hum.Sit = not hum.Sit
        end
    end

    -- إمالة واهتزاز الكاميرا
    local cam = workspace.CurrentCamera
    if cam then
        if Active["Cam Shake"] then
            cam.CFrame = cam.CFrame * CFrame.new(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, 0)
        end
        if Active["Cam Tilt"] then
            cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.rad(math.sin(tick() * 4) * 18))
        end
    end
end)

-- حلقة رسائل الشات المرتبطة بالهدف
local countNum = 0
task.spawn(function()
    local roasts = {"Too slow!", "Target locked!", "Catch me!", "No escape!"}
    local alerts = {"Alert: Target tracked!", "Warning: Chaos active!", "System ping!"}
    local glitches = {"#ERR_404#", "0xGLITCH", "!!OVERRIDE!!"}
    local emojis = {">:)", "?!?", "<<<>>>", "***"}

    while true do
        local delayTime = Active["Fast Chat"] and 0.8 or (Active["Slow Chat"] and 3.5 or 1.8)
        task.wait(delayTime)

        local plr = GetTargetPlayer()
        local tName = plr and plr.DisplayName or "Target"
        local msg = nil

        if Active["Chat Spam"] then
            msg = "[" .. tName .. "] Chaos mode!"
        elseif Active["Roast Spam"] then
            msg = tName .. " - " .. roasts[math.random(1, #roasts)]
        elseif Active["Alert Spam"] then
            msg = alerts[math.random(1, #alerts)] .. " (" .. tName .. ")"
        elseif Active["Glitch Spam"] then
            msg = glitches[math.random(1, #glitches)] .. " " .. tName
        elseif Active["Count Spam"] then
            countNum = countNum + 1
            msg = tName .. " #" .. tostring(countNum)
        elseif Active["Emoji Chat"] then
            msg = tName .. " " .. emojis[math.random(1, #emojis)]
        end

        if msg then
            if Active["Caps Chat"] then
                msg = string.upper(msg)
            end
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                if ch then ch:SendAsync(msg) end
            else
                local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if ev and ev:FindFirstChild("SayMessageRequest") then
                    ev.SayMessageRequest:FireServer(msg, "All")
                end
            end
        end
    end
end)
