local function GetSelfRig()
    local char = LocalPlayer.Character
    if not char then
        return nil, nil, nil, nil
    end
    return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("Head")
end

local function GetTargetPlayer()
    if SelectedTarget and SelectedTarget.Parent == Players and SelectedTarget.Character then
        if SelectedTarget.Character:FindFirstChild("HumanoidRootPart") then
            return SelectedTarget
        end
    end

    local _, myRoot = GetSelfRig()
    local nearestPlr = nil
    local shortestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist = myRoot and (tRoot.Position - myRoot.Position).Magnitude or 0
                if dist < shortestDist then
                    shortestDist = dist
                    nearestPlr = plr
                end
            end
        end
    end

    if nearestPlr then
        HeaderBanner.Text = " CLASSIC 180 UNIQUE SUITE | تلقائي: " .. nearestPlr.Name
    else
        HeaderBanner.Text = " CLASSIC 180 UNIQUE SUITE | لا يوجد لاعب قريب!"
    end

    return nearestPlr
end

local function GetTargetRig()
    local plr = GetTargetPlayer()
    if not plr or not plr.Character then
        return nil, nil, nil, nil, nil
    end
    local tChar = plr.Character
    return plr, tChar, tChar:FindFirstChild("HumanoidRootPart"), tChar:FindFirstChildOfClass("Humanoid"), tChar:FindFirstChild("Head")
end

local function RefreshTargetList()
    for _, child in ipairs(PlayerSelectorList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local filter = string.lower(SearchTargetBox.Text)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local matchUser = string.find(string.lower(plr.Name), filter, 1, true)
            local matchDisp = string.find(string.lower(plr.DisplayName), filter, 1, true)

            if filter == "" or matchUser or matchDisp then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 22)
                btn.BackgroundColor3 = (SelectedTarget == plr) and Color3.fromRGB(178, 38, 38) or Color3.fromRGB(40, 40, 48)
                btn.BorderColor3 = Color3.fromRGB(86, 86, 98)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.SourceSans
                btn.TextSize = 12
                btn.Text = plr.DisplayName
                btn.TextTruncate = Enum.TextTruncate.AtEnd
                btn.ZIndex = 13
                btn.Parent = PlayerSelectorList

                btn.MouseButton1Click:Connect(function()
                    if SelectedTarget == plr then
                        SelectedTarget = nil
                        HeaderBanner.Text = " CLASSIC 180 UNIQUE SUITE | الهدف: أقرب لاعب"
                    else
                        SelectedTarget = plr
                        HeaderBanner.Text = " CLASSIC 180 UNIQUE SUITE | الهدف: " .. plr.Name
                    end
                    RefreshTargetList()
                end)
            end
        end
    end
end

