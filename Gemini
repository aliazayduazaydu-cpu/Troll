-- دوال مساعدة للحصول على مكونات الهدف واللاعب المحلي
local function GetMyParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    return char, root, hum, head
end

local function GetTargetPlayer()
    if SelectedTarget and SelectedTarget.Parent == Players and SelectedTarget.Character then
        local tRoot = SelectedTarget.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            return SelectedTarget
        end
    end

    local _, myRoot = GetMyParts()
    local nearest = nil
    local shortest = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist = myRoot and (tRoot.Position - myRoot.Position).Magnitude or 0
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end

    if nearest then
        TitleBar.Text = " CLASSIC 84 TROLL | تلقائي: " .. nearest.Name
    else
        TitleBar.Text = " CLASSIC 84 TROLL | لا يوجد هدف!"
    end
    return nearest
end

local function GetTargetParts()
    local plr = GetTargetPlayer()
    if not plr or not plr.Character then return nil, nil, nil, nil end
    local tChar = plr.Character
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    local tHead = tChar:FindFirstChild("Head")
    return plr, tChar, tRoot, tHum, tHead
end

-- تحديث قائمة اللاعبين
local function RefreshPlayers()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local query = string.lower(SearchBox.Text)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local matchName = string.find(string.lower(plr.Name), query, 1, true)
            local matchDisplay = string.find(string.lower(plr.DisplayName), query, 1, true)
            if query == "" or matchName or matchDisplay then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 22)
                btn.BackgroundColor3 = (SelectedTarget == plr) and Color3.fromRGB(175, 40, 40) or Color3.fromRGB(40, 40, 48)
                btn.BorderColor3 = Color3.fromRGB(85, 85, 95)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.SourceSans
                btn.TextSize = 12
                btn.Text = plr.DisplayName
                btn.TextTruncate = Enum.TextTruncate.AtEnd
                btn.ZIndex = 12
                btn.Parent = PlayerListFrame

                btn.MouseButton1Click:Connect(function()
                    if SelectedTarget == plr then
                        SelectedTarget = nil
                        TitleBar.Text = " CLASSIC 84 TROLL | الهدف: أقرب لاعب (تلقائي)"
                    else
                        SelectedTarget = plr
                        TitleBar.Text = " CLASSIC 84 TROLL | الهدف: " .. plr.Name
                    end
                    RefreshPlayers()
                end)
            end
        end
    end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshPlayers)
Players.PlayerAdded:Connect(RefreshPlayers)
Players.PlayerRemoving:Connect(function(plr)
    if SelectedTarget == plr then
        SelectedTarget = nil
    end
    RefreshPlayers()
end)
RefreshPlayers()

-- دالة إنشاء زر ميزة (إما لحظي أو Toggle مستمر)
local orderCounter = 0
local function AddFeature(name, isToggle, onTrigger)
    orderCounter = orderCounter + 1
    Active[name] = false

    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.LayoutOrder = orderCounter
    btn.Size = UDim2.new(0, 88, 0, 26)
    btn.BackgroundColor3 = Color3.fromRGB(44, 44, 52)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(95, 95, 105)
    btn.TextColor3 = Color3.fromRGB(245, 245, 250)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Text = name
    btn.TextTruncate = Enum.TextTruncate.AtEnd
    btn.ZIndex = 12
    btn.Parent = FeaturesScroll

    btn.MouseButton1Click:Connect(function()
        if isToggle then
            Active[name] = not Active[name]
            btn.BackgroundColor3 = Active[name] and Color3.fromRGB(185, 42, 42) or Color3.fromRGB(44, 44, 52)
            pcall(onTrigger, Active[name])
        else
            btn.BackgroundColor3 = Color3.fromRGB(210, 125, 30)
            task.delay(0.18, function()
                if btn and btn.Parent then
                    btn.BackgroundColor3 = Color3.fromRGB(44, 44, 52)
                end
            end)
            pcall(onTrigger)
        end
    end)
end

-- دوال مساعدة لتأثيرات الفيزياء والانتقال
local function PulseVelocity(root, vel, duration)
    if not root then return end
    root.AssemblyLinearVelocity = vel
    task.delay(duration or 0.2, function()
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function SpinFlingTarget(tRoot, duration, angularSpeed)
    local _, myRoot = GetMyParts()
    if not myRoot or not tRoot then return end
    local oldCF = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, angularSpeed or 99999, 0)
    bav.Parent = myRoot

    local t0 = tick()
    while tick() - t0 < (duration or 0.75) and tRoot.Parent do
        myRoot.CFrame = tRoot.CFrame
        RunService.Heartbeat:Wait()
    end

    bav:Destroy()
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.CFrame = oldCF
end

