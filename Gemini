-- 10. دوال التنفيذ الفيزيائي وأنماط Bang والشات وإعادة الضبط
------------------------------------------------------------------------------------
local function PushVelocity(velVec, holdSec, returnCFrame)
    local _, myRoot = GetSelfRig()
    if not myRoot then return end
    local savedCF = returnCFrame or myRoot.CFrame
    myRoot.AssemblyLinearVelocity = velVec
    task.delay(holdSec or 0.2, function()
        if myRoot and myRoot.Parent then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            if returnCFrame then
                myRoot.CFrame = savedCF
            end
        end
    end)
end

local function RunSpinFling(tRoot, durationSec, angularPower)
    local _, myRoot = GetSelfRig()
    if not (myRoot and tRoot) then return end
    local savedCF = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, angularPower or 99999, 0)
    bav.Parent = myRoot

    local t0 = tick()
    while tick() - t0 < (durationSec or 0.75) and tRoot.Parent do
        myRoot.CFrame = tRoot.CFrame
        RunService.Heartbeat:Wait()
    end

    bav:Destroy()
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.CFrame = savedCF
end

-- دالة متخصصة لأنواع الـ Bang المتنوعة (Sit Head Bang, Face Bang, Front/Rear/Side/Sky/Spin Bang)
local function ExecuteBangPattern(modeName, cycles, upwardForce, sitMode)
    local _, _, tRoot, _, tHead = GetTargetRig()
    local _, myRoot, myHum = GetSelfRig()
    if not (tRoot and myRoot) then return end

    local savedCF = myRoot.CFrame
    local count = cycles or 8
    local forceY = upwardForce or 180

    if sitMode and myHum then
        myHum.Sit = true
    end

    for i = 1, count do
        if not tRoot.Parent or not myRoot.Parent then break end
        local offsetCF = tRoot.CFrame

        if modeName == "SitHeadBang" and tHead then
            offsetCF = tHead.CFrame * CFrame.new(0, 1.3, 0)
            if myHum then myHum.Sit = true end
        elseif modeName == "FaceBang" and tHead then
            offsetCF = tHead.CFrame * CFrame.new(0, 0, -1.15) * CFrame.Angles(0, math.pi, 0)
        elseif modeName == "HeadTopBang" and tHead then
            offsetCF = tHead.CFrame * CFrame.new(0, 2.0, 0)
        elseif modeName == "FrontBang" then
            offsetCF = tRoot.CFrame * CFrame.new(0, -1.2, -1.8) * CFrame.Angles(0, math.pi, 0)
        elseif modeName == "RearBang" then
            offsetCF = tRoot.CFrame * CFrame.new(0, -1.2, 1.8)
        elseif modeName == "LeftBang" then
            offsetCF = tRoot.CFrame * CFrame.new(-2.0, -1.0, 0)
        elseif modeName == "RightBang" then
            offsetCF = tRoot.CFrame * CFrame.new(2.0, -1.0, 0)
        elseif modeName == "SpinBang" then
            offsetCF = tRoot.CFrame * CFrame.new(0, -1.2, 1.8) * CFrame.Angles(0, math.rad(i * 45), 0)
        elseif modeName == "SkyBang" then
            offsetCF = tRoot.CFrame * CFrame.new(0, -1.5, 0)
            forceY = 270
        elseif modeName == "SlamBang" then
            offsetCF = tRoot.CFrame * CFrame.new(0, 8, 0)
            forceY = -210
        end

        myRoot.CFrame = offsetCF
        myRoot.AssemblyLinearVelocity = Vector3.new(0, forceY, 0)
        task.wait(0.06)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.04)
    end

    if myHum then myHum.Sit = false end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.CFrame = savedCF
end

local function SendChatMessage(msgText)
    if not msgText or msgText == "" then return end
    if FeatureStates["Shout Caps"] then
        msgText = string.upper(msgText)
    end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(msgText) end
    else
        local evFolder = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if evFolder and evFolder:FindFirstChild("SayMessageRequest") then
            evFolder.SayMessageRequest:FireServer(msgText, "All")
        end
    end
end

local function ResetAllFeatures()
    for k in pairs(FeatureStates) do
        FeatureStates[k] = false
    end
    for _, btn in ipairs(RegisteredButtons) do
        if btn and btn.Parent then
            btn.BackgroundColor3 = Color3.fromRGB(42, 42, 50)
        end
    end
    local char, root, hum = GetSelfRig()
    local cam = workspace.CurrentCamera
    if hum and cam then
        cam.CameraSubject = hum
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.Sit = false
    end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = 0
                part.CanCollide = true
            end
        end
    end
end

