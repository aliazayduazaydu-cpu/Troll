-- دالة مساعدة للحصول على الهدف الحالي أو أقرب لاعب تلقائياً
local function GetTarget()
    if SelectedTarget and SelectedTarget.Parent == Players and SelectedTarget.Character and SelectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        return SelectedTarget
    end
    
    -- البحث عن أقرب لاعب في حال عدم تحديد هدف
    local nearestPlayer = nil
    local shortestDist = math.huge
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if myRoot then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestPlayer = plr
                end
            end
        end
    end
    
    if nearestPlayer then
        TitleBar.Text = " الهدف (تلقائي): " .. nearestPlayer.Name
    else
        TitleBar.Text = " خطأ: لا يوجد لاعبون قريبون!"
    end
    return nearestPlayer
end

-- تحديث قائمة اللاعبين الجانبية
local function RefreshPlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -4, 0, 22)
            btn.BackgroundColor3 = (SelectedTarget == plr) and Color3.fromRGB(170, 40, 40) or Color3.fromRGB(40, 40, 48)
            btn.BorderColor3 = Color3.fromRGB(80, 80, 90)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 12
            btn.Text = plr.DisplayName
            btn.TextTruncate = Enum.TextTruncate.AtEnd
            btn.Parent = PlayerListFrame

            btn.MouseButton1Click:Connect(function()
                if SelectedTarget == plr then
                    SelectedTarget = nil
                    TitleBar.Text = " الهدف: أقرب لاعب (تلقائي)"
                else
                    SelectedTarget = plr
                    TitleBar.Text = " الهدف المحدد: " .. plr.Name
                end
                RefreshPlayerList()
            end)
        end
    end
end

Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(function(plr)
    if SelectedTarget == plr then
        SelectedTarget = nil
        TitleBar.Text = " خرج الهدف! التبديل للتلقائي"
    end
    RefreshPlayerList()
end)
RefreshPlayerList()

-- دالة إنشاء زر 40x40 بأيقونة روبلوكس رسمية
local function CreateTrollButton(name, assetId, isToggle, callback)
    local btn = Instance.new("ImageButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 40, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(100, 100, 110)
    btn.Image = assetId
    btn.Parent = ButtonsContainer

    -- نص صغير أسفل الأيقونة لتوضيح الوظيفة
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 11)
    label.Position = UDim2.new(0, 0, 1, -11)
    label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 0.35
    label.BorderSizePixel = 0
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 9
    label.Text = name
    label.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        if isToggle then
            active = not active
            btn.BackgroundColor3 = active and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(45, 45, 52)
            callback(active)
        else
            btn.BackgroundColor3 = Color3.fromRGB(200, 120, 30)
            task.delay(0.2, function()
                btn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            end)
            callback()
        end
    end)
    return btn
end

