RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if FeatureStates["Wall Ghost"] or FeatureStates["Phase Hit"] or FeatureStates["Halo Orbit"] or FeatureStates["Ring Orbit"] or FeatureStates["Saw Orbit"] or FeatureStates["Float Stalk"] or FeatureStates["High Orbit"] or FeatureStates["Low Orbit"] then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if FeatureStates["Watch Cam"] then
        local _, tChar = GetTargetRig()
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = tHum
        end
    end
end)

local angleX = 0
local angleY = 0

RunService.Heartbeat:Connect(function(dt)
    local char, root, hum = GetSelfRig()
    if not char or not root then return end
    local _, _, tRoot, _, tHead = GetTargetRig()

    -- سرعة وقفز عشوائي
    if FeatureStates["Chaos Speed"] and hum then
        hum.WalkSpeed = math.random(8, 125)
    end
    if FeatureStates["Chaos Jump"] and hum then
        hum.JumpPower = math.random(25, 140)
    end

    -- دوران الرأس والجسم
    if FeatureStates["Head Spin"] or FeatureStates["Neck Wobble"] then
        local neck = char:FindFirstChild("Neck", true)
        if neck and neck:IsA("Motor6D") then
            if FeatureStates["Head Spin"] then
                neck.C0 = neck.C0 * CFrame.Angles(0, math.rad(28), 0)
            else
                neck.C0 = neck.C0 * CFrame.Angles(math.sin(tick() * 24) * 0.14, math.cos(tick() * 24) * 0.14, 0)
            end
        end
    end

    if FeatureStates["Flip Loop"] then
        root.CFrame = root.CFrame * CFrame.Angles(math.rad(14), 0, 0)
    end

    if FeatureStates["Twitch Loop"] then
        root.CFrame = root.CFrame * CFrame.Angles(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1)
    end

    -- اهتزازات التخريب
    if FeatureStates["Tremor Jerk"] or FeatureStates["Quake Jerk"] or FeatureStates["Pulse Jerk"] or FeatureStates["Snap Jerk"] or FeatureStates["Jolt Loop"] then
        local baseCF = tRoot and tRoot.CFrame or root.CFrame
        local spread = FeatureStates["Quake Jerk"] and 4.5 or (FeatureStates["Snap Jerk"] and 1.0 or 2.4)
        root.CFrame = baseCF * CFrame.new(math.random(-spread, spread), math.random(0, spread * 0.5), math.random(-spread, spread))
    end

    -- مدارات التخريب والترول
    if tRoot and (FeatureStates["Halo Orbit"] or FeatureStates["Ring Orbit"] or FeatureStates["Wave Orbit"] or FeatureStates["Saw Orbit"] or FeatureStates["Drill Orbit"] or FeatureStates["Slam Orbit"] or FeatureStates["Orbit Smash"] or FeatureStates["High Orbit"] or FeatureStates["Low Orbit"] or FeatureStates["Wide Orbit"] or FeatureStates["Tight Orbit"] or FeatureStates["Orbit Fling"] or FeatureStates["Orbit Bang"]) then
        local spd = (FeatureStates["Drill Orbit"] or FeatureStates["Saw Orbit"]) and 17 or 10
        angleX = angleX + dt * spd
        angleY = angleY + dt * (spd * 1.35)
        local radius = FeatureStates["Wide Orbit"] and 7.5 or (FeatureStates["Tight Orbit"] and 2.5 or 4.5)
        local orbitPos

        if FeatureStates["Halo Orbit"] or FeatureStates["High Orbit"] then
            orbitPos = tRoot.Position + Vector3.new(math.cos(angleX) * radius, 4.5, math.sin(angleX) * radius)
        elseif FeatureStates["Low Orbit"] then
            orbitPos = tRoot.Position + Vector3.new(math.cos(angleX) * radius, -2.5, math.sin(angleX) * radius)
        elseif FeatureStates["Wave Orbit"] then
            orbitPos = tRoot.Position + Vector3.new(math.cos(angleX) * radius, math.sin(angleY) * 3.5, 0)
        elseif FeatureStates["Drill Orbit"] then
            orbitPos = tRoot.Position + Vector3.new(math.cos(angleY) * radius, ((tick() * 9) % 9) - 2, math.sin(angleY) * radius)
        else
            orbitPos = tRoot.Position + Vector3.new(math.cos(angleX) * radius, 0, math.sin(angleX) * radius)
        end

        root.CFrame = CFrame.new(orbitPos, tRoot.Position)
        if FeatureStates["Orbit Fling"] and math.random() < 0.05 then
            RunSpinFling(tRoot, 0.3, 120000)
        end
        if FeatureStates["Orbit Bang"] and math.random() < 0.08 then
            PushVelocity(Vector3.new(0, 140, 0), 0.1)
        end
    end

    -- حلقات Bang المستمرة على الهدف
    if tRoot then
        if FeatureStates["LoopSitBang"] and tHead then
            if hum then hum.Sit = true end
            root.CFrame = tHead.CFrame * CFrame.new(0, 1.3 + math.abs(math.sin(tick() * 18)) * 1.2, 0)
        elseif FeatureStates["LoopFaceBang"] and tHead then
            root.CFrame = tHead.CFrame * CFrame.new(0, 0, -1.1 - math.abs(math.sin(tick() * 18)) * 0.8) * CFrame.Angles(0, math.pi, 0)
        elseif FeatureStates["LoopRearBang"] then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.0, 1.6 + math.abs(math.sin(tick() * 18)) * 1.2)
        elseif FeatureStates["LoopSpinBang"] then
            angleY = angleY + dt * 15
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.0, 1.8) * CFrame.Angles(0, angleY, 0)
        elseif FeatureStates["Rapid Bang"] and math.random() < 0.12 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, -1.2, -1.6)
            PushVelocity(Vector3.new(0, 165, 0), 0.09)
        end
    end

    -- ملاحقة وحركات الترول على الهدف
    if tRoot then
        if FeatureStates["Back Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
        if FeatureStates["Front Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0) end
        if FeatureStates["Left Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(-3.2, 0, 0) end
        if FeatureStates["Right Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(3.2, 0, 0) end
        if FeatureStates["Roof Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 5, 0) end
        if FeatureStates["Floor Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, -4, 0) end
        if FeatureStates["Float Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 3 + math.sin(tick() * 6), 2.5) end
        if FeatureStates["Peep Show"] or FeatureStates["Peek Loop"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, (math.floor(tick() * 2) % 2 == 0) and -2.5 or 6) end
        if FeatureStates["Mirror Pose"] then root.CFrame = CFrame.new(-tRoot.Position.X, tRoot.Position.Y, -tRoot.Position.Z) end
        if FeatureStates["Hop Stalk"] or FeatureStates["Bob Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, math.abs(math.sin(tick() * 8)) * 4, 2.5) end
        if FeatureStates["Sway Stalk"] or FeatureStates["Drift Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 10) * 4, 0, 2.5) end
        if FeatureStates["Stare Lock"] then root.CFrame = CFrame.new(tRoot.Position + tRoot.CFrame.LookVector * 2.5, tRoot.Position) end
        if FeatureStates["Wiggle Stalk"] or FeatureStates["Pulse Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(tick() * 14) * 2.2, 0, 2.6) end
        if FeatureStates["Spin Dance"] or FeatureStates["Spin Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.sin(tick() * 12) * 0.9, 0) end
        if FeatureStates["Roll Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, 0, math.sin(tick() * 10) * 0.5) end
        if FeatureStates["Dash Stalk"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, math.sin(tick() * 9) * 5) end
        if FeatureStates["Loop Stalk"] then angleX = angleX + dt * 5 root.CFrame = tRoot.CFrame * CFrame.new(math.cos(angleX) * 3, 0, math.sin(angleX) * 3) end
        if FeatureStates["Angle Swap"] then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.rad((math.floor(tick() * 3) % 4) * 90), 0) end
        if FeatureStates["Circle Peek"] then angleX = angleX + dt * 6 root.CFrame = tRoot.CFrame * CFrame.new(math.cos(angleX) * 5, 0, math.sin(angleX) * 5) end
        if FeatureStates["Blink Warp"] or FeatureStates["Warp Loop"] then
            if math.random() < 0.08 then
                root.CFrame = tRoot.CFrame * CFrame.new(math.random(-6, 6), math.random(0, 4), math.random(-6, 6))
            end
        end

        -- هجمات تخريب تلقائية مستمرة
        if FeatureStates["Auto Fling"] and math.random() < 0.04 then RunSpinFling(tRoot, 0.35, 99999) end
        if (FeatureStates["Auto Slam"] or FeatureStates["Slam Loop"]) and math.random() < 0.06 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 12, 0)
            PushVelocity(Vector3.new(0, -175, 0), 0.16)
        end
        if (FeatureStates["Auto Shock"] or FeatureStates["Shock Loop"] or FeatureStates["Boom Loop"]) and math.random() < 0.06 then
            root.CFrame = tRoot.CFrame
            PushVelocity(Vector3.new(math.random(-145, 145), 135, math.random(-145, 145)), 0.14)
        end
        if (FeatureStates["Blitz Loop"] or FeatureStates["Dash Loop"] or FeatureStates["Surge Loop"]) and math.random() < 0.08 then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
            PushVelocity(tRoot.CFrame.LookVector * 185, 0.12)
        end
        if FeatureStates["Pulse Loop"] and math.random() < 0.08 then PushVelocity(Vector3.new(0, 115, 0), 0.12) end
        if FeatureStates["Burst Cycle"] and math.random() < 0.05 then root.CFrame = tRoot.CFrame * CFrame.new(0, -1.5, 0) PushVelocity(Vector3.new(0, 185, 0), 0.15) end
        if FeatureStates["Spin Loop"] and math.random() < 0.04 then RunSpinFling(tRoot, 0.3, 110000) end
        if (FeatureStates["Drop Loop"] or FeatureStates["Crash Loop"]) and math.random() < 0.06 then root.CFrame = tRoot.CFrame * CFrame.new(0, 20, 0) PushVelocity(Vector3.new(0, -220, 0), 0.15) end
        if FeatureStates["Kick Loop"] and math.random() < 0.06 then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -2) PushVelocity(tRoot.CFrame.LookVector * 200 + Vector3.new(0, 90, 0), 0.14) end
    end

    -- وميض بصري
    if FeatureStates["Flash Blink"] or FeatureStates["Fade Blink"] then
        local transVal = FeatureStates["Flash Blink"] and (math.random() > 0.5 and 0 or 0.85) or (0.35 + 0.35 * math.sin(tick() * 10))
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = transVal
            end
        end
    end

    -- قفز وجلوس متكرر
    if hum then
        if FeatureStates["Hop Spam"] and math.random() < 0.12 then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if FeatureStates["Sit Spam"] and math.random() < 0.08 then hum.Sit = not hum.Sit end
    end

    -- تأثيرات الكاميرا
    local cam = workspace.CurrentCamera
    if cam then
        if FeatureStates["Shake Cam"] then cam.CFrame = cam.CFrame * CFrame.new(math.random(-2, 2) * 0.1, math.random(-2, 2) * 0.1, 0) end
        if FeatureStates["Tilt Cam"] then cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.rad(math.sin(tick() * 4) * 18)) end
    end
end)

-- حلقة رسائل الشات المرتبطة بالهدف
local seqNum = 0
task.spawn(function()
    local teasePool = {"Too slow!", "Catch me!", "No escape!", "Over here!"}
    local alertPool = {"Alert: Tracked!", "Warning: Locked!", "Ping active!"}
    local codePool = {"#ERR_01#", "0xCHAOS", "!!SYNC!!"}
    local markPool = {">:-)", "?!?", "<<<>>>", "***"}

    while true do
        local waitSec = FeatureStates["Fast Pace"] and 0.8 or (FeatureStates["Slow Pace"] and 3.5 or 1.8)
        task.wait(waitSec)

        local plr = GetTargetPlayer()
        local tName = plr and plr.DisplayName or "Target"
        local line = nil

        if FeatureStates["Tag Chat"] then
            line = "[" .. tName .. "] Target active"
        elseif FeatureStates["Tease Chat"] then
            line = tName .. " - " .. teasePool[math.random(1, #teasePool)]
        elseif FeatureStates["Alert Chat"] then
            line = alertPool[math.random(1, #alertPool)] .. " " .. tName
        elseif FeatureStates["Code Chat"] then
            line = codePool[math.random(1, #codePool)] .. " " .. tName
        elseif FeatureStates["Num Chat"] then
            seqNum = seqNum + 1
            line = tName .. " #" .. tostring(seqNum)
        elseif FeatureStates["Mark Chat"] then
            line = tName .. " " .. markPool[math.random(1, #markPool)]
        end

        if line then
            SendChatMessage(line)
        end
    end
end)
