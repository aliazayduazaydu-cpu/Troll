-- 5) Fling
local function flingNpc(npc)
    local r = npc:FindFirstChild("HumanoidRootPart")
    if not r or r:FindFirstChild("NPC_Fling") then return end
    local a = Instance.new("BodyAngularVelocity")
    a.Name = "NPC_Fling"
    a.AngularVelocity = Vector3.new(999, 999, 999)
    a.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    a.Parent = r
    local v = Instance.new("BodyVelocity")
    v.Name = "NPC_Fling2"
    v.Velocity = Vector3.new(math.random(-50, 50), 500, math.random(-50, 50))
    v.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    v.Parent = r
    task.delay(2, function()
        if a.Parent then a:Destroy() end
        if v.Parent then v:Destroy() end
    end)
end

createButton(ICONS.fling, "Fling NPC", function()
    flingNpc(S.Target)
    notify("Fling!")
end)

-- 6) Control (WASD)
createButton(ICONS.control, "Control NPC (WASD+Space)", function()
    if S.ControlConn then
        S.ControlConn:Disconnect() S.ControlConn = nil
        return false
    end
    local h = hum()
    if not h then return false end
    S.ControlConn = RunService.RenderStepped:Connect(function()
        if not alive() then
            if S.ControlConn then S.ControlConn:Disconnect() S.ControlConn = nil end
            return
        end
        local cam = Workspace.CurrentCamera
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude > 0 and h then h:Move(dir.Unit, false) end
        if UIS:IsKeyDown(Enum.KeyCode.Space) and h then h.Jump = true end
    end)
    notify("Control ON: WASD + Space")
    return true
end, {toggle = true})

