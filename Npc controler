-- 13) ESP (toggle)
local function addESP(npc, r)
    if not r or r:FindFirstChild("NPC_ESP") then return end
    local b = Instance.new("BillboardGui")
    b.Name = "NPC_ESP" b.Size = UDim2.new(0, 130, 0, 44)
    b.StudsOffset = Vector3.new(0, 3, 0) b.AlwaysOnTop = true
    b.Adornee = r b.Parent = r

    local nm = Instance.new("TextLabel", b)
    nm.Size = UDim2.new(1, 0, 0, 20) nm.BackgroundTransparency = 1
    nm.Text = npc.Name nm.TextColor3 = C.Blue
    nm.TextStrokeTransparency = 0 nm.Font = SIZE.Font nm.TextSize = 14

    local bg = Instance.new("Frame", b)
    bg.Size = UDim2.new(1, 0, 0, 10) bg.Position = UDim2.new(0, 0, 0, 22)
    bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30) bg.BorderSizePixel = 1
    bg.BorderColor3 = C.Border

    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new(1, 0, 1, 0) fill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    fill.BorderSizePixel = 0

    local h = npc:FindFirstChildOfClass("Humanoid")
    if h then
        local conn
        conn = h.HealthChanged:Connect(function(hp)
            if not fill.Parent then conn:Disconnect() return end
            fill.Size = UDim2.new(math.clamp(hp / h.MaxHealth, 0, 1), 0, 1, 0)
        end)
    end
    table.insert(S.ESPObjects, b)
end

createButton(ICONS.esp, "ESP all NPCs", function()
    S.ESPOn = not S.ESPOn
    if S.ESPOn then
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("Model") and o ~= LP.Character and o:FindFirstChildOfClass("Humanoid") then
                local r = o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart
                if r then addESP(o, r) end
            end
        end
        S.ESPConn = Workspace.DescendantAdded:Connect(function(d)
            if S.ESPOn and d:IsA("HumanoidRootPart") then
