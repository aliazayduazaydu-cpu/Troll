-- 16-18) Aura (exclusive)
local function setAura(mode)
    if S.AuraMode == mode then S.AuraMode = nil else S.AuraMode = mode end
    if S.AuraThread then task.cancel(S.AuraThread) S.AuraThread = nil end
    if not S.AuraMode then return nil end
    local active = S.AuraMode
    S.AuraThread = task.spawn(function()
        while S.AuraMode == active do
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                for _, o in ipairs(Workspace:GetDescendants()) do
                    if o:IsA("Model") and o ~= LP.Character and o:FindFirstChildOfClass("Humanoid") then
                        local r = o:FindFirstChild("HumanoidRootPart")
                        if r and (r.Position - myRoot.Position).Magnitude <= 22 then
                            if active == "fling" then flingNpc(o)
                            elseif active == "kill" then
                                local h = o:FindFirstChildOfClass("Humanoid")
                                if h then h.Health = 0 end
                            elseif active == "jump" then
                                local h = o:FindFirstChildOfClass("Humanoid")
                                if h then h.Jump = true end
                            end
                        end
                    end
                end
            end
            task.wait(0.4)
        end
    end)
    return active
end

