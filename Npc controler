-- ═══════════════════ NOTIFY ═══════════════════
local function notify(text, color)
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0, 240, 0, 28)
    n.Position = UDim2.new(0.5, -120, 0, 40)
    n.BackgroundColor3 = color or C.Blue
    n.BorderSizePixel = 1
    n.BorderColor3 = C.Border
    n.Text = text
    n.TextColor3 = C.Text
    n.Font = SIZE.Font
    n.TextSize = 12
    n.ZIndex = 100
    n.Parent = Gui
    TweenService:Create(n, TweenInfo.new(0.25), {Position = UDim2.new(0.5, -120, 0, 52)}):Play()
    task.delay(2, function()
        if n.Parent then
            TweenService:Create(n, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -120, 0, 20), BackgroundTransparency = 1, TextTransparency = 1}):Play()
            task.wait(0.4) n:Destroy()
        end
    end)
end

-- ═══════════════════ SET TARGET ═══════════════════
local function setTarget(npc)
    if S.Highlight then S.Highlight:Destroy() S.Highlight = nil end
    if S.FollowConn then S.FollowConn:Disconnect() S.FollowConn = nil end
    S.FollowTarget = nil
    S.Target = npc

    if npc then
        TargetLbl.Text = "🎯 " .. npc.Name
        TargetLbl.TextColor3 = C.Text
        S.Highlight = Instance.new("Highlight")
        S.Highlight.FillColor = C.Blue
        S.Highlight.FillTransparency = 0.75
        S.Highlight.OutlineColor = C.Blue
        S.Highlight.Adornee = npc
        S.Highlight.Parent = npc
        npc.AncestryChanged:Connect(function()
            if not npc:IsDescendantOf(Workspace) and S.Target == npc then setTarget(nil) end
        end)
    else
        TargetLbl.Text = "🎯 No Target — click to open picker"
        TargetLbl.TextColor3 = C.SubText
    end
end

