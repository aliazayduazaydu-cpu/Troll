-- ═══════════════════ TOGGLE LOGIC ═══════════════════
local menuOpen = false
local function toggleMenu()
    menuOpen = not menuOpen
    if menuOpen then
        Menu.Visible = true
        Menu.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(Menu, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = SIZE.Menu}):Play()
    else
        local t = TweenService:Create(Menu, TweenInfo.new(0.15), {Size = UDim2.new(0, 0, 0, 0)})
        t:Play()
        t.Completed:Connect(function() Menu.Visible = false end)
    end
end

Toggle.MouseButton1Click:Connect(toggleMenu)
CloseBtn.MouseButton1Click:Connect(toggleMenu)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then toggleMenu() end
end)

