-- ═══════════════════ BUTTON FACTORY (with rbxassetid images) ═══════════════════
local function createButton(iconCfg, tooltip, callback, opts)
    opts = opts or {}
    local requireTarget = opts.requireTarget
    if requireTarget == nil then requireTarget = true end
    local isToggle = opts.toggle or false
    local state = false

    local B = Instance.new("TextButton")
    B.Size = SIZE.Button
    B.BackgroundColor3 = C.BtnNormal
    B.BorderSizePixel = 1
    B.BorderColor3 = C.Border
    B.AutoButtonColor = false
    B.Text = ""                     -- نص فارغ — نستخدم الصورة
    B.TextColor3 = C.Text
    B.TextSize = 20
    B.Font = SIZE.Font
    B.Parent = BScroll

    -- Image icon (rbxassetid) + fallback to emoji
    local Img = Instance.new("ImageLabel")
    Img.Size = UDim2.new(0, 26, 0, 26)
    Img.Position = UDim2.new(0.5, -13, 0.5, -13)
    Img.BackgroundTransparency = 1
    Img.Image = "rbxassetid://" .. iconCfg.id
    Img.ScaleType = Enum.ScaleType.Fit
    Img.Parent = B
    Img.ImageFailed:Connect(function()
        Img:Destroy()
        B.Text = iconCfg.fb          -- fallback emoji
    end)

    local function setActive(on)
        state = on
        B.BackgroundColor3 = on and C.BtnActive or C.BtnNormal
        B.BorderColor3 = on and Color3.fromRGB(0, 90, 50) or C.Border
    end

    B.MouseEnter:Connect(function()
        if not state then B.BackgroundColor3 = C.BtnHover end
        if S.Target then
            TargetLbl.Text = "▸ " .. tooltip .. "  [" .. S.Target.Name .. "]"
        else
            TargetLbl.Text = "▸ " .. tooltip
        end
        TargetLbl.TextColor3 = C.Text
    end)
    B.MouseLeave:Connect(function()
        if not state then B.BackgroundColor3 = C.BtnNormal end
        TargetLbl.Text = S.Target and ("🎯 " .. S.Target.Name) or "🎯 No Target — click to open picker"
        TargetLbl.TextColor3 = S.Target and C.Text or C.SubText
    end)

    B.MouseButton1Click:Connect(function()
        if requireTarget and not alive() then
            notify("Select a valid NPC first", C.Danger)
            return
        end
        local ok, result = pcall(callback, state)
        if not ok then
            notify("Error: " .. tostring(result):sub(1, 30), C.Danger)
            return
        end
        if isToggle then setActive(result == true) end
    end)

    return B
end

