    if S.ClickMode and i.UserInputType == Enum.UserInputType.MouseButton1 then
        local t = Mouse.Target
        if t then
            local m = t:FindFirstAncestorOfClass("Model")
            if m and m ~= LP.Character and m:FindFirstChildOfClass("Humanoid") then
                setTarget(m)
                notify("Target: " .. m.Name)
                S.ClickMode = false
            end
        end
    end
end)

