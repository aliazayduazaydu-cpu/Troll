local function startFollow(target)
    if S.FollowConn then S.FollowConn:Disconnect() end
    S.FollowTarget = target
    S.FollowConn = RunService.Heartbeat:Connect(function()
        if not alive() then return end
        local tgtChar = (target == "me") and LP.Character or (target and target.Character)
        if not tgtChar then return end
        local tgtRoot = tgtChar:FindFirstChild("HumanoidRootPart")
        local h = hum()
        if tgtRoot and h then h:MoveTo(tgtRoot.Position) end
    end)
end
local function stopFollow()
    if S.FollowConn then S.FollowConn:Disconnect() S.FollowConn = nil end
    S.FollowTarget = nil
end

